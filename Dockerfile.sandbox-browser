ARG BASE_IMAGE=coreblow-sandbox-common:latest
FROM ${BASE_IMAGE}

USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    chromium \
    fonts-liberation \
    libnss3 \
    libxss1 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium

USER sandbox
WORKDIR /app

CMD ["node", "dist/entry.js", "sandbox", "--port", "3100", "--browser"]
