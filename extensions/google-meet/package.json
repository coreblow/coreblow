{
  "name": "@coreblow/google-meet",
  "version": "2026.5.17",
  "description": "CoreBlow Google Meet participant plugin",
  "repository": {
    "type": "git",
    "url": "https://github.com/coreblow/coreblow"
  },
  "type": "module",
  "dependencies": {
    "commander": "14.0.3",
    "typebox": "1.1.38"
  },
  "devDependencies": {
    "@coreblow/plugin-sdk": "workspace:*",
    "coreblow": "workspace:*"
  },
  "peerDependencies": {
    "coreblow": ">=2.0.0"
  },
  "peerDependenciesMeta": {
    "coreblow": {
      "optional": true
    }
  },
  "coreblow": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@coreblow/google-meet",
      "defaultChoice": "npm",
      "minHostVersion": ">=2.0.0"
    },
    "compat": {
      "pluginApi": ">=2.0.0"
    },
    "build": {
      "coreblowVersion": "2026.5.17"
    },
    "release": {
      "publishToCoreHub": true,
      "publishToNpm": true
    }
  }
}
