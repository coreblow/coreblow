{
  "name": "@coreblow/irc",
  "type": "module",
  "version": "0.1.0",
  "description": "CoreBlow IRC channel plugin",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.7"
  },
  "coreblow": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "irc",
      "label": "IRC",
      "selectionLabel": "IRC (Server + Nick)",
      "detailLabel": "IRC",
      "docsPath": "/channels/irc",
      "docsLabel": "irc",
      "blurb": "classic IRC networks with DM/channel routing and pairing controls.",
      "systemImage": "network"
    },
    "setupEntry": "./setup-entry.ts",
    "install": {
      "minHostVersion": ">=1.0.0"
    }
  }
}
