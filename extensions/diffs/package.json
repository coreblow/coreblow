{
  "name": "@coreblow/diffs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "CoreBlow diff viewer plugin",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:viewer": "bun build src/viewer-client.ts --target browser --format esm --minify --outfile assets/viewer-runtime.js",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@pierre/diffs": "^1.1.19",
    "playwright-core": "^1.59.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.4"
  },
  "coreblow": {
    "extensions": [
      "./index.ts"
    ],
    "bundle": {
      "stageRuntimeDependencies": true
    }
  }
}
