{
  "id": "tencent",
  "activation": {
    "onStartup": false
  },
  "enabledByDefault": true,
  "providerCatalogEntry": "./provider-discovery.ts",
  "providers": [
    "tencent-tokenhub"
  ],
  "modelCatalog": {
