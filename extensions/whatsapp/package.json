{
  "name": "@coreblow/whatsapp",
  "type": "module",
  "version": "0.1.0",
  "description": "CoreBlow WhatsApp channel plugin",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.4"
  },
  "coreblow": {
    "extensions": [
      "./index.ts"
    ],
    "setupEntry": "./setup-entry.ts",
    "channel": {
      "id": "whatsapp",
      "label": "WhatsApp",
      "selectionLabel": "WhatsApp (QR link)",
      "detailLabel": "WhatsApp Web",
      "docsPath": "/channels/whatsapp",
      "docsLabel": "whatsapp",
      "blurb": "works with your own number; recommend a separate phone + eSIM.",
      "systemImage": "message"
    },
    "install": {
      "npmSpec": "@coreblow/whatsapp",
      "localPath": "extensions/whatsapp",
      "defaultChoice": "npm",
      "minHostVersion": ">=1.0.0"
    }
  }
}
