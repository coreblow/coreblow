{
  "name": "@coreblow/bonjour",
  "version": "2026.5.17",
  "description": "CoreBlow Bonjour/mDNS gateway discovery",
  "type": "module",
  "dependencies": {
    "@homebridge/ciao": "1.3.8"
  },
  "devDependencies": {
    "coreblow": "workspace:*"
  },
  "coreblow": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@coreblow/bonjour",
      "localPath": "extensions/bonjour",
      "defaultChoice": "npm",
      "minHostVersion": ">=1.0.0"
    }
  }
}
