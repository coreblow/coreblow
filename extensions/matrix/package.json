{
  "name": "@coreblow/matrix",
  "type": "module",
  "version": "0.1.0",
  "description": "CoreBlow Matrix channel plugin",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "coreblow": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "matrix",
      "label": "Matrix",
      "selectionLabel": "Matrix (plugin)",
      "docsPath": "/channels/matrix",
      "docsLabel": "matrix",
      "blurb": "open protocol; install the plugin to enable.",
      "order": 70,
      "quickstartAllowFrom": true
    },
    "setupEntry": "./setup-entry.ts",
    "install": {
      "npmSpec": "@coreblow/matrix",
      "localPath": "extensions/matrix",
      "defaultChoice": "npm",
      "minHostVersion": ">=1.0.0"
    }
  }
}
