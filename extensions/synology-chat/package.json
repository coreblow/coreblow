{
  "name": "@coreblow/synology-chat",
  "type": "module",
  "version": "0.1.0",
  "description": "Synology Chat channel plugin for CoreBlow",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.4"
  },
  "coreblow": {
    "extensions": [
      "./index.ts"
    ],
    "channel": {
      "id": "synology-chat",
      "label": "Synology Chat",
      "selectionLabel": "Synology Chat (Webhook)",
      "docsPath": "/channels/synology-chat",
      "docsLabel": "synology-chat",
      "blurb": "Connect your Synology NAS Chat to CoreBlow with full agent capabilities.",
      "order": 90
    },
    "setupEntry": "./setup-entry.ts",
    "install": {
      "npmSpec": "@coreblow/synology-chat",
      "localPath": "extensions/synology-chat",
      "defaultChoice": "npm",
      "minHostVersion": ">=1.0.0"
    }
  }
}
