{
  "name": "@coreblow/memory-lancedb",
  "type": "module",
  "version": "0.1.0",
  "description": "CoreBlow LanceDB-backed long-term memory plugin with auto-recall/capture",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "eslint src/"
  },
  "dependencies": {
    "@lancedb/lancedb": "^0.27.1",
    "@sinclair/typebox": "0.34.48",
    "openai": "^6.33.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  },
  "coreblow": {
    "extensions": [
      "./index.ts"
    ],
    "install": {
      "npmSpec": "@coreblow/memory-lancedb",
      "localPath": "extensions/memory-lancedb",
      "defaultChoice": "npm",
      "minHostVersion": ">=1.0.0"
    }
  }
}
