{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2023",
        "outDir": "./dist",
        "rootDir": ".",
        "noEmit": false,
        "emitDeclarationOnly": true,
        "noImplicitAny": false,
        "declaration": true,
        "declarationMap": true,
        "sourceMap": false,
        "paths": {
            "coreblow/extension-api": ["./src/extensionAPI.ts"],
            "coreblow/plugin-sdk": ["./src/plugin-sdk/index.ts"],
            "coreblow/plugin-sdk/*": ["./src/plugin-sdk/*.ts"],
            "coreblow/plugin-sdk/account-id": ["./src/plugin-sdk/account-id.ts"]
        }
    },
    "include": ["src/**/*.ts", "extensions/**/*.ts", "packages/**/*.ts"],
    "exclude": [
        "node_modules",
        "dist",
        "tests",
        "src/**/*.test.ts",
        "src/**/*.test-helpers.ts",
        "extensions/**/*.test.ts",
        "packages/**/*.test.ts",
        "src/plugin-sdk/acpx.ts",
        "src/plugin-sdk/agent-config-primitives.ts",
        "src/plugin-sdk/agent-media-payload.ts",
