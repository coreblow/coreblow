# CoreBlow .env example
#
# Quick start:
# 1) Copy this file to `.env` (for local runs from this repo), OR to `~/.coreblow/.env` (for launchd/systemd daemons).
# 2) Fill only the values you use.
# 3) Keep real secrets out of git.
#
# Env-source precedence for environment variables (highest -> lowest):
# process env, ./.env, ~/.coreblow/.env, then coreblow.json `env` block.
# Existing non-empty process env vars are not overridden by dotenv/config env loading.
# Note: direct config keys (for example `gateway.auth.token` or channel tokens in coreblow.json)
# are resolved separately from env loading and often take precedence over env fallbacks.

# -----------------------------------------------------------------------------
# Gateway auth + paths
# -----------------------------------------------------------------------------
# Recommended if the gateway binds beyond loopback.
COREBLOW_GATEWAY_TOKEN=change-me-to-a-long-random-token
# Example generator: openssl rand -hex 32

# Optional alternative auth mode (use token OR password).
# COREBLOW_GATEWAY_PASSWORD=change-me-to-a-strong-password

# Optional path overrides (defaults shown for reference).
# COREBLOW_STATE_DIR=~/.coreblow
# COREBLOW_CONFIG_PATH=~/.coreblow/coreblow.json
# COREBLOW_HOME=~

# Optional: import missing keys from your login shell profile.
# COREBLOW_LOAD_SHELL_ENV=1

# -----------------------------------------------------------------------------
# Environment
# -----------------------------------------------------------------------------
NODE_ENV=production
PORT=3000

# -----------------------------------------------------------------------------
# LLM Providers (at least one required)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AI...
# GROQ_API_KEY=gsk_...
# DEEPSEEK_API_KEY=...

# -----------------------------------------------------------------------------
# Gateway (self-hosted)
# -----------------------------------------------------------------------------
COREBLOW_GATEWAY_PORT=3000
COREBLOW_GATEWAY_BIND=lan              # lan | localhost | 0.0.0.0

# -----------------------------------------------------------------------------
# Docker-specific
# -----------------------------------------------------------------------------
COREBLOW_IMAGE=coreblow:local          # Docker image tag
COREBLOW_CONFIG_DIR=~/.coreblow        # Config mount path
COREBLOW_WORKSPACE_DIR=~/.coreblow/workspace  # Workspace mount
COREBLOW_TZ=UTC                        # Timezone

# -----------------------------------------------------------------------------
# Channels (optional)
# -----------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=xoxb-...
TELEGRAM_BOT_TOKEN=
# WHATSAPP_PHONE_ID=
# SIGNAL_PHONE_NUMBER=

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=sqlite://./data/coreblow.db

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=
