# ─────────────────────────────────────────────────────────────────
# CoreBlow Configuration
# Copy this file to .env and fill in the values.
# ─────────────────────────────────────────────────────────────────

# ── Environment ─────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── LLM Providers (at least one required) ───────────────────────
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AI...

# ── Gateway (self-hosted) ───────────────────────────────────────
COREBLOW_GATEWAY_TOKEN=           # Auth token for gateway connections
COREBLOW_GATEWAY_PORT=3000        # Port to expose
COREBLOW_GATEWAY_BIND=lan         # lan | localhost | 0.0.0.0

# ── Docker-specific ─────────────────────────────────────────────
COREBLOW_IMAGE=coreblow:local     # Docker image tag
COREBLOW_CONFIG_DIR=~/.coreblow   # Config mount path
COREBLOW_WORKSPACE_DIR=~/.coreblow/workspace  # Workspace mount
COREBLOW_TZ=UTC                   # Timezone

# ── Channels (optional) ────────────────────────────────────────
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=xoxb-...
TELEGRAM_BOT_TOKEN=

# ── Database ───────────────────────────────────────────────────
DATABASE_URL=sqlite://./data/coreblow.db

# ── Security ───────────────────────────────────────────────────
JWT_SECRET=change-me-in-production
ENCRYPTION_KEY=
