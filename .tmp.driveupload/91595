/**
 * agents/tool-loop-detection.ts
 * Detects stuck tool-call loops and circuit-breaks runaway agents.
 * Ported 1:1 from OpenClaw src/agents/tool-loop-detection.ts.
 */

import { createHash } from 'node:crypto';

export type LoopDetectorKind = 'generic_repeat' | 'known_poll_no_progress' | 'global_circuit_breaker' | 'ping_pong';

export type LoopDetectionResult =
    | { stuck: false }
    | { stuck: true; level: 'warning' | 'critical'; detector: LoopDetectorKind; count: number; message: string; pairedToolName?: string; warningKey?: string };

export const TOOL_CALL_HISTORY_SIZE = 30;
export const WARNING_THRESHOLD = 10;
export const CRITICAL_THRESHOLD = 20;
export const GLOBAL_CIRCUIT_BREAKER_THRESHOLD = 30;

export interface ToolLoopDetectionConfig {
    enabled: boolean;
    historySize: number;
    warningThreshold: number;
    criticalThreshold: number;
    globalCircuitBreakerThreshold: number;
    detectors: { genericRepeat: boolean; knownPollNoProgress: boolean; pingPong: boolean };
}

const DEFAULT_CONFIG: ToolLoopDetectionConfig = {
    enabled: false,
    historySize: TOOL_CALL_HISTORY_SIZE,
    warningThreshold: WARNING_THRESHOLD,
    criticalThreshold: CRITICAL_THRESHOLD,
    globalCircuitBreakerThreshold: GLOBAL_CIRCUIT_BREAKER_THRESHOLD,
    detectors: { genericRepeat: true, knownPollNoProgress: true, pingPong: true },
};

export interface ToolCallRecord {
    toolName: string;
    argsHash: string;
    timestamp: number;
}

export function resolveToolLoopConfig(cfg?: Record<string, unknown>): ToolLoopDetectionConfig {
    const tools = cfg?.tools as Record<string, unknown> | undefined;
    const loop = tools?.loopDetection as Record<string, unknown> | undefined;
    if (!loop) return { ...DEFAULT_CONFIG };
    return {
        enabled: typeof loop.enabled === 'boolean' ? loop.enabled : DEFAULT_CONFIG.enabled,
        historySize: typeof loop.historySize === 'number' ? loop.historySize : DEFAULT_CONFIG.historySize,
        warningThreshold: typeof loop.warningThreshold === 'number' ? loop.warningThreshold : DEFAULT_CONFIG.warningThreshold,
        criticalThreshold: typeof loop.criticalThreshold === 'number' ? loop.criticalThreshold : DEFAULT_CONFIG.criticalThreshold,
        globalCircuitBreakerThreshold: typeof loop.globalCircuitBreakerThreshold === 'number' ? loop.globalCircuitBreakerThreshold : DEFAULT_CONFIG.globalCircuitBreakerThreshold,
        detectors: { genericRepeat: true, knownPollNoProgress: true, pingPong: true },
    };
}

export function hashToolArgs(args: unknown): string {
    const canonical = typeof args === 'string' ? args : JSON.stringify(args ?? '');
    return createHash('sha256').update(canonical).digest('hex').slice(0, 16);
}

export function detectToolLoop(history: ToolCallRecord[], configOrMaxFreq?: ToolLoopDetectionConfig | number, directThreshold?: number): LoopDetectionResult & { loopDetected?: boolean; type?: string } {
    // Legacy mode: numeric args or no config → use legacy detectors
    if (!configOrMaxFreq || typeof configOrMaxFreq === 'number') {
        const threshold = directThreshold ?? 4;
        const direct = detectDirectRepeats(history, threshold);
        if (direct.loopDetected) return { stuck: true, level: 'warning', detector: 'generic_repeat', count: direct.count!, message: direct.message!, loopDetected: true, type: direct.type };
        const alt = detectAlternatingLoop(history);
        if (alt.loopDetected) return { stuck: true, level: 'warning', detector: 'ping_pong', count: alt.count!, message: alt.message!, loopDetected: true, type: alt.type };
        if (typeof configOrMaxFreq === 'number') {
            const freq = detectFrequencyAbuse(history, configOrMaxFreq);
            if (freq.loopDetected) return { stuck: true, level: 'warning', detector: 'generic_repeat', count: freq.count!, message: freq.message!, loopDetected: true, type: freq.type };
        }
        return { stuck: false, loopDetected: false };
    }
    const config = configOrMaxFreq;
    if (!config.enabled || history.length < 2) return { stuck: false };
    if (history.length >= config.globalCircuitBreakerThreshold) {
        return { stuck: true, level: 'critical', detector: 'global_circuit_breaker', count: history.length, message: `Global circuit breaker: ${history.length} tool calls exceeded threshold ${config.globalCircuitBreakerThreshold}` };
    }
    if (config.detectors.genericRepeat) { const r = detectGenericRepeat(history, config); if (r.stuck) return r; }
    if (config.detectors.pingPong) { const r = detectPingPong(history, config); if (r.stuck) return r; }
    if (config.detectors.knownPollNoProgress) { const r = detectKnownPollNoProgress(history, config); if (r.stuck) return r; }
    return { stuck: false };
}

function detectGenericRepeat(history: ToolCallRecord[], config: ToolLoopDetectionConfig): LoopDetectionResult {
    const window = history.slice(-config.historySize);
    const last = window[window.length - 1];
    const repeatCount = window.filter((r) => r.toolName === last.toolName && r.argsHash === last.argsHash).length;
    if (repeatCount >= config.criticalThreshold) return { stuck: true, level: 'critical', detector: 'generic_repeat', count: repeatCount, message: `Tool "${last.toolName}" repeated ${repeatCount} times with identical args` };
    if (repeatCount >= config.warningThreshold) return { stuck: true, level: 'warning', detector: 'generic_repeat', count: repeatCount, message: `Tool "${last.toolName}" repeated ${repeatCount} times — possible loop`, warningKey: `repeat:${last.toolName}` };
    return { stuck: false };
}

function detectPingPong(history: ToolCallRecord[], config: ToolLoopDetectionConfig): LoopDetectionResult {
    if (history.length < 4) return { stuck: false };
    const recent = history.slice(-20);
    const toolA = recent[recent.length - 2].toolName;
    const toolB = recent[recent.length - 1].toolName;
    if (toolA === toolB) return { stuck: false };
    let alternations = 0;
    for (let i = recent.length - 1; i >= 1; i--) {
        if ((recent[i].toolName === toolA && recent[i - 1].toolName === toolB) || (recent[i].toolName === toolB && recent[i - 1].toolName === toolA)) alternations++;
        else break;
    }
    if (alternations >= config.criticalThreshold) return { stuck: true, level: 'critical', detector: 'ping_pong', count: alternations, message: `Ping-pong: "${toolA}" ↔ "${toolB}" (${alternations}x)`, pairedToolName: toolB };
    if (alternations >= config.warningThreshold) return { stuck: true, level: 'warning', detector: 'ping_pong', count: alternations, message: `Possible ping-pong: "${toolA}" ↔ "${toolB}"`, pairedToolName: toolB, warningKey: `pingpong:${toolA}:${toolB}` };
    return { stuck: false };
}

const POLL_PATTERNS = ['read', 'get', 'list', 'check', 'status', 'poll', 'fetch', 'search'];

function detectKnownPollNoProgress(history: ToolCallRecord[], config: ToolLoopDetectionConfig): LoopDetectionResult {
    const window = history.slice(-config.historySize);
    const pollOnly = window.every((r) => POLL_PATTERNS.some((p) => r.toolName.toLowerCase().includes(p)));
    if (!pollOnly || window.length < config.warningThreshold) return { stuck: false };
    const uniqueArgs = new Set(window.map((r) => `${r.toolName}:${r.argsHash}`));
    if (uniqueArgs.size <= 2) return { stuck: true, level: 'warning', detector: 'known_poll_no_progress', count: window.length, message: `${window.length} consecutive poll/read calls with no progress` };
    return { stuck: false };
}

// ─── Legacy API (backward compat) ────────────────────────────────

type LegacyLoopResult = { loopDetected: boolean; type?: string; count?: number; message?: string };

/**
 * Hash args with sorted keys for deterministic comparison.
 */
export function hashArgs(args: unknown): string {
    if (typeof args === 'string') return hashToolArgs(args);
    if (args && typeof args === 'object') {
        const sorted = Object.fromEntries(Object.entries(args as Record<string, unknown>).sort(([a], [b]) => a.localeCompare(b)));
        return hashToolArgs(sorted);
    }
    return hashToolArgs(args);
}

export function detectDirectRepeats(history: ToolCallRecord[], threshold = 4): LegacyLoopResult {
    if (history.length < threshold) return { loopDetected: false };
    const last = history[history.length - 1];
    const count = history.filter((r) => r.toolName === last.toolName && r.argsHash === last.argsHash).length;
    if (count >= threshold) return { loopDetected: true, type: 'direct', count, message: `Direct repeat: ${last.toolName} x${count}` };
    return { loopDetected: false };
}

export function detectAlternatingLoop(history: ToolCallRecord[], threshold = 3): LegacyLoopResult {
    if (history.length < threshold * 2) return { loopDetected: false };
    const last2 = history.slice(-2);
    const a = last2[0].toolName;
    const b = last2[1].toolName;
    if (a === b) return { loopDetected: false };
    let alt = 0;
    for (let i = history.length - 1; i >= 1; i--) {
        if ((history[i].toolName === a && history[i - 1].toolName === b) || (history[i].toolName === b && history[i - 1].toolName === a)) alt++;
        else break;
    }
    if (alt >= threshold) return { loopDetected: true, type: 'alternating', count: alt, message: `Alternating: ${a} ↔ ${b} x${alt}` };
    return { loopDetected: false };
}

export function detectNgramPattern(history: ToolCallRecord[], n: number, threshold = 2): LegacyLoopResult {
    if (history.length < n * threshold) return { loopDetected: false };
    const lastN = history.slice(-n).map((r) => r.toolName).join(',');
    let found = 0;
    for (let i = 0; i <= history.length - n; i++) {
        const gram = history.slice(i, i + n).map((r) => r.toolName).join(',');
        if (gram === lastN) found++;
    }
    if (found >= threshold) return { loopDetected: true, type: 'ngram', count: found, message: `N-gram pattern x${found}` };
    return { loopDetected: false };
}

export function detectFrequencyAbuse(history: ToolCallRecord[], maxPerMinute = 30): LegacyLoopResult {
    const now = Date.now();
    const recent = history.filter((r) => now - r.timestamp < 60_000);
    if (recent.length > maxPerMinute) return { loopDetected: true, type: 'frequency', count: recent.length, message: `${recent.length} calls/min exceeds ${maxPerMinute}` };
    return { loopDetected: false };
}

// Session-based history storage
const sessionHistories = new Map<string, ToolCallRecord[]>();

export function recordToolCall(sessionId: string, record: ToolCallRecord): void {
    const history = sessionHistories.get(sessionId) ?? [];
    history.push(record);
    if (history.length > 200) history.splice(0, history.length - 200);
    sessionHistories.set(sessionId, history);
}

export function getSessionHistory(sessionId: string): ToolCallRecord[] {
    return sessionHistories.get(sessionId) ?? [];
}

export function clearSessionHistory(sessionId: string): void {
    sessionHistories.delete(sessionId);
}

export function clearAllHistories(): void {
    sessionHistories.clear();
}

export function getLoopDetectionStats(sessionId: string): { totalCalls: number; uniqueTools: number; mostCalledTool: string } {
    const history = getSessionHistory(sessionId);
    const counts = new Map<string, number>();
    for (const r of history) counts.set(r.toolName, (counts.get(r.toolName) ?? 0) + 1);
    let mostCalledTool = '';
    let maxCount = 0;
    for (const [tool, count] of counts) {
        if (count > maxCount) { mostCalledTool = tool; maxCount = count; }
    }
    return { totalCalls: history.length, uniqueTools: counts.size, mostCalledTool };
}

/**
 * Detect stale loop — same call repeated after long idle.
 */
export function detectStaleLoop(history: ToolCallRecord[], idleThresholdMs = 60_000): LegacyLoopResult {
    if (history.length < 2) return { loopDetected: false };
    const last = history[history.length - 1];
    const prev = history[history.length - 2];
    if (last.toolName === prev.toolName && last.argsHash === prev.argsHash && (last.timestamp - prev.timestamp) >= idleThresholdMs) {
        return { loopDetected: true, type: 'stale', count: 2, message: `Stale loop: ${last.toolName} repeated after ${last.timestamp - prev.timestamp}ms idle` };
    }
    return { loopDetected: false };
}

// Circuit breaker
export class ToolCircuitBreaker {
    private state: 'closed' | 'open' | 'half-open' = 'closed';
    private failures = 0;
    private successesInHalfOpen = 0;
    private lastFailureAt = 0;
    private readonly threshold: number;
    private readonly resetMs: number;
    private readonly requiredSuccesses: number;

    constructor(threshold = 5, resetMs = 30_000, requiredSuccesses = 1) {
        this.threshold = threshold;
        this.resetMs = resetMs;
        this.requiredSuccesses = requiredSuccesses;
    }

    canExecute(): boolean {
        if (this.state === 'closed') return true;
        if (this.state === 'open' && Date.now() - this.lastFailureAt >= this.resetMs) {
            this.state = 'half-open';
            this.successesInHalfOpen = 0;
            return true;
        }
        return this.state === 'half-open';
    }

    recordSuccess(): void {
        if (this.state === 'half-open') {
            this.successesInHalfOpen++;
            if (this.successesInHalfOpen >= this.requiredSuccesses) {
                this.state = 'closed';
                this.failures = 0;
                this.successesInHalfOpen = 0;
            }
        } else {
            this.state = 'closed';
            this.failures = 0;
        }
    }

    recordFailure(): void {
        this.failures++;
        this.lastFailureAt = Date.now();
        if (this.failures >= this.threshold || this.state === 'half-open') {
            this.state = 'open';
            this.successesInHalfOpen = 0;
        }
    }

    isOpen(): boolean { return !this.canExecute(); }
    getState(): string { return this.state; }
    getFailures(): number { return this.failures; }
    reset(): void { this.state = 'closed'; this.failures = 0; this.lastFailureAt = 0; this.successesInHalfOpen = 0; }
}
