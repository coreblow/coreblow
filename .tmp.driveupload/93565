/**
 * Wave 41: Reply Pipeline II
 * Tests for agent-runner, provider-dispatcher, and queue.
 */

import { describe, it, expect, beforeEach, vi } from 'vitest';
import { AgentRunner, type AgentRunnerOptions, type ToolCall, type ToolResult } from '../../src/auto-reply/reply/agent-runner.js';
import { ProviderDispatcher, type ProviderRoute } from '../../src/auto-reply/reply/provider-dispatcher.js';
import { ReplyQueue } from '../../src/auto-reply/reply/queue.js';
// Define simplified type for ReplyEnvelope
interface ReplyEnvelope {
    sessionId: string;
    priority: number;
    inbound: { id: string, channel: string };
    context: any;
}

describe('Wave 41: Reply Pipeline II', () => {

    describe('Agent Runner (agent-runner.ts)', () => {
        let runner: AgentRunner;

        beforeEach(() => {
            runner = new AgentRunner({ maxIterations: 5, maxToolCalls: 10, timeoutMs: 1000, requireApproval: false });
        });

        it('should return immediately if no tool calls', async () => {
            const generateFn = vi.fn().mockResolvedValue({
                content: 'Hello response',
                toolCalls: [],
                usage: { total_tokens: 10 }
            });
            const executeFn = vi.fn();

            const res = await runner.run([{ role: 'user', content: 'hi' }], generateFn, executeFn);

            expect(res.iterations).toBe(1);
            expect(res.toolCallsExecuted).toBe(0);
            expect(res.finalResponse).toBe('Hello response');
            expect(res.totalTokens).toBe(10);
            expect(generateFn).toHaveBeenCalledTimes(1);
            expect(executeFn).toHaveBeenCalledTimes(0);
        });

        it('should execute tool calls and reiterate', async () => {
            let genCalls = 0;
            const generateFn = vi.fn().mockImplementation(async () => {
                genCalls++;
                if (genCalls === 1) {
                    return {
                        content: '',
                        toolCalls: [{ id: 't1', name: 'search', arguments: {} } as ToolCall],
                        usage: { total_tokens: 15 }
                    };
                }
                return {
                    content: 'Done',
                    toolCalls: [],
                    usage: { total_tokens: 20 }
                };
            });

            const executeFn = vi.fn().mockResolvedValue({
                toolCallId: 't1',
                name: 'search',
                content: 'Search Result',
                isError: false
            } as ToolResult);

            const res = await runner.run([], generateFn, executeFn);

            expect(res.iterations).toBe(2);
            expect(res.toolCallsExecuted).toBe(1);
            expect(res.totalTokens).toBe(35);
            expect(res.finalResponse).toBe('Done');
            expect(executeFn).toHaveBeenCalledTimes(1);
            expect(executeFn.mock.calls[0][0].name).toBe('search');
        });

        it('should abort when requested', async () => {
            const generateFn = vi.fn().mockImplementation(async () => {
                runner.abort(); // simulate abort from outside while generating
                return {
                    content: '',
                    toolCalls: [{ id: 't1', name: 'search', arguments: {} } as ToolCall],
                    usage: { total_tokens: 10 }
                };
            });
            const executeFn = vi.fn();

            const res = await runner.run([], generateFn, executeFn);

            expect(res.abortReason).toBe('aborted');
            expect(res.iterations).toBe(1); // Didn't continue past first iteration
            expect(executeFn).toHaveBeenCalledTimes(0); // skipped executing because aborted
        });

        it('should enforce max iterations', async () => {
            const runner2 = new AgentRunner({ maxIterations: 2, maxToolCalls: 10, timeoutMs: 5000, requireApproval: false });

            const generateFn = vi.fn().mockResolvedValue({
                content: '',
                toolCalls: [{ id: 't1', name: 'loop', arguments: {} } as ToolCall],
                usage: { total_tokens: 10 }
            });
            const executeFn = vi.fn().mockResolvedValue({
                toolCallId: 't1', name: 'loop', content: '...', isError: false
            } as ToolResult);

            const res = await runner2.run([], generateFn, executeFn);
            expect(res.iterations).toBe(2); // stop at max
            expect(res.abortReason).toBe('max_iterations');
            expect(res.toolCallsExecuted).toBe(2);
        });

        it('should enforce max tool calls', async () => {
            const runner2 = new AgentRunner({ maxIterations: 10, maxToolCalls: 2, timeoutMs: 5000, requireApproval: false });

            const generateFn = vi.fn().mockResolvedValue({
                content: '',
                toolCalls: [
                    { id: 't1', name: 'a', arguments: {} },
                    { id: 't2', name: 'b', arguments: {} },
                    { id: 't3', name: 'c', arguments: {} }
                ] as ToolCall[],
                usage: { total_tokens: 10 }
            });
            const executeFn = vi.fn();

            const res = await runner2.run([], generateFn, executeFn);
            expect(res.iterations).toBe(1);
            expect(res.abortReason).toBe('max_tool_calls');
            expect(res.toolCallsExecuted).toBe(0); // Bails before executing this batch
        });

        it('should enforce timeout', async () => {
            const runner2 = new AgentRunner({ maxIterations: 10, maxToolCalls: 10, timeoutMs: 50, requireApproval: false });

            const generateFn = vi.fn().mockImplementation(async () => {
                await new Promise(r => setTimeout(r, 60)); // Simulate slow LLM
                return {
                    content: 'Done', toolCalls: [], usage: { total_tokens: 10 }
                };
            });

            // Actually it checks timeout AT START of iteration! So it does 1 iteration, then next iteration checks.
            // Let's make it do 2 iterations.
            let c = 0;
            const generateFnSlow = vi.fn().mockImplementation(async () => {
                c++;
                await new Promise(r => setTimeout(r, 60)); // Exceeds timeout
                return {
                    content: '', toolCalls: [{ id: 'foo', name: 'foo', arguments: {} }], usage: { total_tokens: 10 }
                };
            });
            const executeFn = vi.fn().mockResolvedValue({ content: '..' });

            const res = await runner2.run([], generateFnSlow, executeFn);
            expect(res.abortReason).toBe('timeout');
            expect(res.iterations).toBe(1); // 1st complete, 2nd aborts before gen
        });
    });

    describe('Provider Dispatcher (provider-dispatcher.ts)', () => {
        let dispatcher: ProviderDispatcher;

        beforeEach(() => {
            dispatcher = new ProviderDispatcher();
        });

        it('configureRoutes loads and prioritizes routes', () => {
            dispatcher.configureRoutes([
                { providerId: 'p1', model: 'm1', priority: 1, maxRetries: 1, timeoutMs: 1000, isAvailable: true },
                { providerId: 'p2', model: 'm2', priority: 10, maxRetries: 1, timeoutMs: 1000, isAvailable: true }
            ]);
            expect(dispatcher.routeCount).toBe(2);
            const report = dispatcher.getHealthReport();
            expect(report).toHaveLength(2);
            expect(report[0].isHealthy).toBe(true);
        });

        it('dispatch uses highest priority available provider', async () => {
            dispatcher.configureRoutes([
                { providerId: 'p1', model: 'm1', priority: 1, maxRetries: 1, timeoutMs: 1000, isAvailable: true },
                { providerId: 'p2', model: 'm2', priority: 10, maxRetries: 1, timeoutMs: 1000, isAvailable: true }
            ]);

            const generateFn = vi.fn().mockResolvedValue({
                content: 'Response',
                usage: { prompt_tokens: 5, completion_tokens: 5, total_tokens: 10 }
            });

            const res = await dispatcher.dispatch([{ role: 'user', content: 'x' }], {}, generateFn);

            expect(res.providerId).toBe('p2'); // Highest priority first
            expect(res.fromFallback).toBe(false);
            expect(generateFn).toHaveBeenCalledWith('p2', 'm2', expect.any(Array), expect.any(Object));
        });

        it('dispatch falls back on error', async () => {
            dispatcher.configureRoutes([
                { providerId: 'p1', model: 'm1', priority: 10, maxRetries: 1, timeoutMs: 1000, isAvailable: true },
                { providerId: 'p2', model: 'm2', priority: 5, maxRetries: 1, timeoutMs: 1000, isAvailable: true }
            ]);

            const generateFn = vi.fn().mockImplementation(async (pid) => {
                if (pid === 'p1') throw new Error('Network error');
                return { content: 'Fallback Response', usage: { prompt_tokens: 5, completion_tokens: 5, total_tokens: 10 } };
            });

            const res = await dispatcher.dispatch([], {}, generateFn);

            expect(res.providerId).toBe('p2');
            expect(res.fromFallback).toBe(true);
        });

        it('dispatch prefers explicit model requested', async () => {
            dispatcher.configureRoutes([
                { providerId: 'p1', model: 'gpt-3.5', priority: 10, maxRetries: 1, timeoutMs: 1000, isAvailable: true },
                { providerId: 'p2', model: 'gpt-4', priority: 5, maxRetries: 1, timeoutMs: 1000, isAvailable: true }
            ]);

            const generateFn = vi.fn().mockResolvedValue({
                content: 'Response', usage: { prompt_tokens: 0, completion_tokens: 0, total_tokens: 0 }
            });

            const res = await dispatcher.dispatch([], { model: 'gpt-4' }, generateFn);

            expect(res.providerId).toBe('p2'); // Even though p1 is higher priority, p2 has the requested model
        });

        it('dispatch throws if all providers fail', async () => {
            dispatcher.configureRoutes([
                { providerId: 'p1', model: 'm1', priority: 1, maxRetries: 1, timeoutMs: 1000, isAvailable: true }
            ]);

            const generateFn = vi.fn().mockRejectedValue(new Error('Fatal API Error'));

            await expect(dispatcher.dispatch([], {}, generateFn)).rejects.toThrow('Fatal API Error');

            const health = dispatcher.getHealthReport().find(h => h.providerId === 'p1')!;
            expect(health.errorCount).toBe(1);
        });

        it('isHealthy marks provider unhealthy after 3 errors', async () => {
            dispatcher.configureRoutes([
                { providerId: 'p1', model: 'm1', priority: 1, maxRetries: 1, timeoutMs: 1000, isAvailable: true }
            ]);

            const generateFn = vi.fn().mockRejectedValue(new Error('Fail'));

            // Need 3 dispatches to reach threshold
            await expect(dispatcher.dispatch([], {}, generateFn)).rejects.toThrow();
            await expect(dispatcher.dispatch([], {}, generateFn)).rejects.toThrow();
            await expect(dispatcher.dispatch([], {}, generateFn)).rejects.toThrow();

            expect(dispatcher.isHealthy('p1')).toBe(false);
        });

        it('throws immediately if no routes available', async () => {
            dispatcher.configureRoutes([]);
            await expect(dispatcher.dispatch([], {}, vi.fn())).rejects.toThrow('No providers available for dispatch');
        });
    });

    describe('Reply Queue (queue.ts)', () => {
        let queue: ReplyQueue;

        beforeEach(() => {
            queue = new ReplyQueue(10, 5); // maxSize 10, rateLimit 5/min
        });

        function createEnv(id: string, channelId = 'ch1', priority = 0): ReplyEnvelope {
            return {
                sessionId: id,
                priority,
                inbound: { id, channel: channelId } as any,
                context: {} as any
            } as any;
        }

        it('enqueue adds item and sorts by priority', () => {
            const e1 = createEnv('msg1', 'ch1', 1);
            const e2 = createEnv('msg2', 'ch1', 10);

            queue.enqueue(e1);
            queue.enqueue(e2);

            expect(queue.size).toBe(2);
            const next = queue.dequeue();
            expect(next?.sessionId).toBe('msg2'); // Higher priority first
        });

        it('enqueue prevents exact duplicates', () => {
            const e1 = createEnv('msg1');
            const res1 = queue.enqueue(e1);
            const res2 = queue.enqueue(e1);

            expect(res1).toBe(true);
            expect(res2).toBe(false); // Rejected
            expect(queue.size).toBe(1);
        });

        it('enqueue honors max size limit', () => {
            const q = new ReplyQueue(2, 10);
            const e1 = createEnv('m1');
            const e2 = createEnv('m2');
            const e3 = createEnv('m3');

            expect(q.enqueue(e1)).toBe(true);
            expect(q.enqueue(e2)).toBe(true);
            expect(q.enqueue(e3)).toBe(false); // Queue full
        });

        it('enqueue honors global rate limit', () => {
            const q = new ReplyQueue(10, 2); // 2 globally!

            expect(q.enqueue(createEnv('m1', 'ch1'))).toBe(true);
            expect(q.enqueue(createEnv('m2', 'ch1'))).toBe(true);
            expect(q.enqueue(createEnv('m3', 'ch1'))).toBe(false); // Rate limited

            expect(q.enqueue(createEnv('m4', 'ch2'))).toBe(false); // Fails because limit is global!
        });

        it('complete removes from processing', () => {
            queue.enqueue(createEnv('m1'));
            queue.dequeue(); // Moves to processing
            expect(queue.processingCount).toBe(1);

            queue.complete('m1');
            expect(queue.processingCount).toBe(0);
        });

        it('fail returns false since element is already dequeued (known parity issue)', () => {
            const env = createEnv('m1');
            queue.enqueue(env);
            queue.dequeue(); // Into processing

            expect(queue.processingCount).toBe(1);

            // Because it was shifted from queue, queue.find fails and it returns false
            const r1 = queue.fail(env, 2);
            expect(r1).toBe(false);
            expect(queue.processingCount).toBe(0);
        });

        it('cleanup removes old recentReplies tracking', () => {
            queue.enqueue(createEnv('m1'));
            expect(queue.enqueue(createEnv('m1'))).toBe(false); // Dup

            // Cleanup with maxAge -1 (removes everything)
            queue.cleanup(-1);

            // Now m1 is accepted again
            expect(queue.enqueue(createEnv('m1'))).toBe(true);
        });
    });
});
