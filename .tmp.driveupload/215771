services:
  coreblow-gateway:
    image: ${COREBLOW_IMAGE:-coreblow:local}
    environment:
      HOME: /home/node
      TERM: xterm-256color
      COREBLOW_TOKEN: ${COREBLOW_TOKEN:-}
      TZ: ${COREBLOW_TZ:-UTC}
    volumes:
      - ${COREBLOW_CONFIG_DIR:-./data}:/home/node/.coreblow
    ports:
      - "${COREBLOW_GATEWAY_PORT:-3000}:3000"
    init: true
    restart: unless-stopped
    healthcheck:
      test:
        [
          "CMD",
          "node",
          "-e",
          "fetch('http://127.0.0.1:3000/api/health').then((r)=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))",
        ]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 20s

  sandbox:
    build:
      context: .
      dockerfile: Dockerfile.sandbox
    network_mode: none
    cap_drop:
      - NET_RAW
      - NET_ADMIN
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: '1.0'
          memory: 512M

  sandbox-browser:
    build:
      context: .
      dockerfile: Dockerfile.sandbox-browser
    cap_drop:
      - NET_RAW
      - NET_ADMIN
    security_opt:
      - no-new-privileges:true
    deploy:
      resources:
        limits:
          cpus: '2.0'
          memory: 1G

volumes:
  coreblow-data:
