/**
 * flows/flow-engine.ts
 * Conversation flow engine — run multi-step interactive dialogs.
 */

import { randomUUID } from 'node:crypto';
import { createChildLogger } from '../utils/logger.js';
import type { FlowDefinition, FlowInstance, FlowStep, FlowState } from './types.js';

const log = createChildLogger('flow-engine');

export class FlowEngine {
    private flows = new Map<string, FlowInstance>();

    /** Start a new flow. */
    async start(definition: FlowDefinition, sessionId: string): Promise<FlowInstance> {
        const instance: FlowInstance = {
            id: `flow_${randomUUID().replace(/-/g, '').slice(0, 12)}`,
            definition,
            currentStep: definition.initialStep,
            state: 'active',
            data: {},
            startedAt: Date.now(),
            lastActivityAt: Date.now(),
            history: [],
        };

        this.flows.set(`${sessionId}:${instance.id}`, instance);

        const step = this.getStep(instance);
        if (step?.onEnter) await step.onEnter();

        instance.state = 'waiting_input';
        log.info({ flowId: instance.id, flow: definition.name, step: instance.currentStep }, 'Flow started');
        return instance;
    }

    /** Process user input for an active flow. */
    async processInput(sessionId: string, flowId: string, input: string): Promise<{ prompt?: string; completed: boolean; error?: string }> {
        const key = `${sessionId}:${flowId}`;
        const instance = this.flows.get(key);
        if (!instance || instance.state !== 'waiting_input') {
            return { completed: false, error: 'No active flow or not waiting for input' };
        }

        const step = this.getStep(instance);
        if (!step) return { completed: false, error: `Step ${instance.currentStep} not found` };

        // Validate
        if (step.validator) {
            const validation = step.validator(input);
            if (!validation.valid) {
                return { prompt: validation.error ?? 'Invalid input. Please try again.', completed: false };
            }
        }

        // Transform & store
        const value = step.transform ? step.transform(input) : input;
        instance.data[step.id] = value;
        instance.history.push({ step: step.id, input: value, at: Date.now() });
        instance.lastActivityAt = Date.now();

        // Exit current step
        if (step.onExit) await step.onExit();

        // Determine next step
        const nextId = typeof step.next === 'function' ? step.next(value) : step.next;

        if (!nextId) {
            // Flow complete
            instance.state = 'completed';
            if (instance.definition.onComplete) await instance.definition.onComplete(instance.data);
            this.flows.delete(key);
            log.info({ flowId, flow: instance.definition.name }, 'Flow completed');
            return { completed: true };
        }

        // Move to next step
        instance.currentStep = nextId;
        const nextStep = this.getStep(instance);
        if (nextStep?.onEnter) await nextStep.onEnter();
        instance.state = 'waiting_input';

        return { prompt: nextStep?.prompt, completed: false };
    }

    /** Cancel a flow. */
    async cancel(sessionId: string, flowId: string): Promise<void> {
        const key = `${sessionId}:${flowId}`;
        const instance = this.flows.get(key);
        if (!instance) return;

        instance.state = 'cancelled';
        if (instance.definition.onCancel) await instance.definition.onCancel();
        this.flows.delete(key);
        log.info({ flowId }, 'Flow cancelled');
    }

    /** Get the active flow for a session. */
    getActiveFlow(sessionId: string): FlowInstance | null {
        for (const [key, flow] of this.flows) {
            if (key.startsWith(`${sessionId}:`) && flow.state === 'waiting_input') return flow;
        }
        return null;
    }

    /** List all flows, optionally filtered by session ID. */
    listFlows(sessionId?: string): FlowInstance[] {
        const result: FlowInstance[] = [];
        for (const [key, flow] of this.flows) {
            if (!sessionId || key.startsWith(`${sessionId}:`)) {
                result.push(flow);
            }
        }
        return result;
    }

    /** Get a specific flow by its ID. */
    getFlowById(flowId: string, sessionId?: string): FlowInstance | undefined {
        if (sessionId) {
            return this.flows.get(`${sessionId}:${flowId}`);
        }

        // Search across all sessions
        for (const [key, flow] of this.flows) {
            if (key.endsWith(`:${flowId}`)) {
                return flow;
            }
        }
        return undefined;
    }

    /** Clean up expired flows. */
    async cleanExpired(): Promise<number> {
        let cleaned = 0;
        const toCancel: { key: string; flow: FlowInstance }[] = [];

        for (const [key, flow] of this.flows) {
            const timeout = flow.definition.timeoutMs ?? 300_000;
            if (Date.now() - flow.lastActivityAt > timeout && flow.state !== 'completed' && flow.state !== 'cancelled') {
                toCancel.push({ key, flow });
            }
        }

        for (const { key, flow } of toCancel) {
            flow.state = 'cancelled';
            try {
                if (flow.definition.onCancel) await flow.definition.onCancel();
            } catch (err) {
                log.error({ flowId: flow.id, err: err instanceof Error ? err.message : String(err) }, 'Error during flow cancel');
            }
            this.flows.delete(key);
            log.info({ flowId: flow.id }, 'Flow timed out and cancelled');
            cleaned++;
        }

        return cleaned;
    }

    private getStep(instance: FlowInstance): FlowStep | undefined {
        return instance.definition.steps.find(s => s.id === instance.currentStep);
    }

    get activeCount(): number { return this.flows.size; }
}

let defaultEngine: FlowEngine | null = null;
export function getFlowEngine(): FlowEngine {
    if (!defaultEngine) defaultEngine = new FlowEngine();
    return defaultEngine;
}
