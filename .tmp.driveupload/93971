import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
import { CircuitBreaker } from '../../src/infra/circuit-breaker.js';
import { RetryPolicy } from '../../src/infra/retry-policy.js';
import { HealthAggregator } from '../../src/infra/health.js';
import { EventBus } from '../../src/infra/event-bus.js';
import { StateMachine } from '../../src/infra/state-machine.js';
import { MessageBroker } from '../../src/infra/message-broker.js';
import { LRUCache } from '../../src/infra/lru-cache.js';

describe('Wave 56: Infrastructure E2E Integration', () => {

    beforeEach(() => {
        vi.useFakeTimers();
    });

    afterEach(() => {
        vi.useRealTimers();
        vi.restoreAllMocks();
    });

    it('orchestrates full resilience and monitoring lifecycle', async () => {
        // 1. Setup Components
        const eventBus = new EventBus();
        const health = new HealthAggregator();
        const circuitBreaker = new CircuitBreaker();
        const broker = new MessageBroker();
        const cache = new LRUCache<string>(100, 60000);

        let externalServiceAvailable = false;

        // Mock external call with intermittent failures
        const externalCall = async (payload: string) => {
            if (!externalServiceAvailable) {
                eventBus.emit('network.error', { target: 'external', payload });
                throw new Error('Connection refused');
            }
            return `Processed: ${payload}`;
        };

        // 2. Health Monitoring Integration
        health.register('external_api', async () => {
            const state = circuitBreaker.getState('external');
            if (state === 'open') {
                return { name: 'external_api', status: 'unhealthy', lastCheckedAt: Date.now(), message: 'Circuit open' };
            }
            if (state === 'half-open') {
                return { name: 'external_api', status: 'degraded', lastCheckedAt: Date.now(), message: 'Circuit half-open' };
            }
            return { name: 'external_api', status: 'healthy', lastCheckedAt: Date.now() };
        });

        // 3. Message Broker + Circuit Breaker Consumer
        broker.subscribe('outbound', async (msg) => {
            try {
                 // Try to fire through circuit breaker
                 const result = await circuitBreaker.execute('external', () => externalCall(msg.payload as string), {
                     failureThreshold: 2,
                     resetTimeoutMs: 30000,
                     halfOpenMaxCalls: 1
                 });
                 cache.set(msg.id, result); // Cache success
                 eventBus.emit('message.delivered', { id: msg.id, result });
                 return true;
            } catch (err) {
                 return false; // Will trigger broker retry
            }
        });

        // 4. Initial state checks
        let sysHealth = await health.check();
        expect(sysHealth.status).toBe('healthy');

        // 5. Publish messages while service is down
        externalServiceAvailable = false;
        const msg1 = broker.publish('outbound', 'msg1', 0, 10);
        const msg2 = broker.publish('outbound', 'msg2', 0, 10);

        // Attempt 1 for msg1 -> Fails -> Circuit has 1 failure
        await broker.processNext('outbound');
        // Attempt 1 for msg2 -> Fails -> Circuit has 2 failures -> OPENS
        await broker.processNext('outbound');

        expect(circuitBreaker.getState('external')).toBe('open');

        // Advance time to bypass health aggregator cache (10s), but keep CB open (reset is 30s)
        await vi.advanceTimersByTimeAsync(11000);

        // 6. Health should now reflect unhealthy circuit
        sysHealth = await health.check();
        expect(sysHealth.status).toBe('unhealthy');

        // Attempt 2 for msg1 -> Fails fast (circuit open)
        await broker.processNext('outbound');

        // 7. Time passes, circuit goes half-open
        await vi.advanceTimersByTimeAsync(20000); // Total 31s passed
        expect(circuitBreaker.getState('external')).toBe('half-open');

        // Advance 10s to bypass health cache again
        await vi.advanceTimersByTimeAsync(11000);

        // Health should be degraded
        sysHealth = await health.check();
        expect(sysHealth.status).toBe('degraded');

        // 8. Service comes back online
        externalServiceAvailable = true;

        // Provide success -> circuit closes
        // Note: msg2 attempt 2 is next in queue maybe? Or msg1 attempt 3.
        // Let's just process whatever is next.
        await broker.processNext('outbound');

        expect(circuitBreaker.getState('external')).toBe('closed');

        // Bypass cache
        await vi.advanceTimersByTimeAsync(11000);

        // Health should be healthy
        sysHealth = await health.check();
        expect(sysHealth.status).toBe('healthy');

        // Process remaining messages
        while (broker.depth('outbound') > 0) {
            await broker.processNext('outbound');
        }

        // 9. Verify caches and events
        expect(cache.has(msg1.id)).toBe(true);
        expect(cache.has(msg2.id)).toBe(true);

        const deliverEvents = eventBus.getHistory('message.delivered');
        expect(deliverEvents.length).toBeGreaterThanOrEqual(2);
    });

    it('integrates state machine with event bus and retry policy', async () => {
        const sm = new StateMachine();
        const bus = new EventBus();
        const retry = new RetryPolicy({ maxRetries: 2, baseDelayMs: 10, jitter: false });

        sm.define({
            id: 'job',
            initialState: 'pending',
            states: ['pending', 'running', 'success', 'failed'],
            transitions: [
                { from: 'pending', to: 'running', event: 'start' },
                { from: 'running', to: 'success', event: 'finish' },
                { from: 'running', to: 'failed', event: 'error' }
            ]
        });

        const instance = sm.create('job')!;

        // Bind state machine transitions to event bus
        bus.on('job.start', () => { sm.send(instance.id, 'start'); });
        bus.on('job.finish', () => { sm.send(instance.id, 'finish'); });
        bus.on('job.error', () => { sm.send(instance.id, 'error'); });

        let attempts = 0;
        const task = async () => {
             attempts++;
             if (attempts < 3) throw new Error('tmp');
             return 'done';
        };

        // Trigger start
        await bus.emit('job.start');
        expect(sm.getState(instance.id)).toBe('running');

        // Run with retry policy concurrently with advancing timers
        const p = retry.execute(task);
        await vi.runAllTimersAsync();
        const result = await p;

        if (result.success) {
            await bus.emit('job.finish');
        } else {
            await bus.emit('job.error');
        }

        expect(result.success).toBe(true);
        expect(result.attempts).toBe(3);
        expect(sm.getState(instance.id)).toBe('success');
    });

});
