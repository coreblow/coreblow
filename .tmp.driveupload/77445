name: CI — Lint & Type Check
on:
  push:
    branches: [main, develop]
  pull_request:
    branches: [main]

jobs:
  lint:
    runs-on: ubuntu-latest
    defaults:
      run:
        working-directory: gateway
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-node@v4
        with:
          node-version: '22'
          cache: 'npm'
          cache-dependency-path: gateway/package-lock.json
      - run: npm ci
      - run: npx tsc --noEmit
      - name: Check for raw eval()
        run: "! grep -rn 'eval(' src --include='*.ts' | grep -v 'test\\|safeEvaluateMath\\|sanitize\\|vm\\|\\.eval\\b\\|//\\|/\\*'"
      - name: Check for empty catch blocks
        run: "! grep -rn 'catch\\s*{\\s*}' src --include='*.ts' | grep -v 'intentionally'"
