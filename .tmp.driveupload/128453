/**
 * GoogleGeminiCliAuth Types
 */
export interface GoogleGeminiCliAuthMessage {
  id: string;
  channelId: string;
  userId: string;
  content: string;
  timestamp: number;
  metadata?: Record<string, any>;
}

export interface GoogleGeminiCliAuthUser {
  id: string;
  name: string;
  avatar?: string;
}

export interface GoogleGeminiCliAuthChannel {
  id: string;
  name: string;
  type: 'dm' | 'group' | 'channel';
}
