/**
 * CoreBlow Phase 41 — MCP Approval Pipeline Chain Tests
 *
 * Layer 2 (Pipeline):
 *   Bridge Request → Pending List → Execute Approval → Event Generation
 */
import { describe, it, expect } from 'vitest';
import { CoreBlowChannelBridge } from '../../src/mcp/channel-bridge.js';

describe('Phase41 Chain: MCP Approval Pipeline', () => {
    it('request permission → wait for approval → generate resolved event', async () => {
        const bridge = new CoreBlowChannelBridge({});
        await bridge.start();

        // 1. Tool requests permission via MCP
        await bridge.handleClaudePermissionRequest({
            requestId: 'req-abc',
            toolName: 'fs_write',
            description: 'Write to system file',
            inputPreview: { file: '/etc/hosts' },
        });

        // 2. Client checks pending list
        const pending = await bridge.listPendingApprovals();
        expect(pending).toHaveLength(1);
        expect(pending[0]?.id).toBe('req-abc');

        // 3. User clicks "Approve" -> generates event
        const approvalPromise = bridge.waitForEvent({ type: 'exec_approval_resolved' });
        await bridge.handleApproval('req-abc', 'approved');

        // 4. MCP bridge relays resolution
        const resolutionEvent = await approvalPromise;
        expect((resolutionEvent as any)?.raw?.id).toBe('req-abc');
        expect((resolutionEvent as any)?.raw?.decision).toBe('approved');

        // 5. List is now empty
        const pendingAfter = await bridge.listPendingApprovals();
        expect(pendingAfter).toHaveLength(0);
    });
});
