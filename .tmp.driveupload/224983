export class MemoryTools { private store = new Map<string, Record<string, unknown>>(); remember(key: string, value: unknown) { this.store.set(key, { value, storedAt: Date.now() }); } recall(key: string) { return this.store.get(key)?.value; } forget(key: string) { this.store.delete(key); } search(query: string) { return [...this.store.entries()].filter(([k]) => k.includes(query)).map(([k, v]) => ({ key: k, ...v })); } }
