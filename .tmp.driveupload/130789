/**
 * Discord Types
 */
export interface DiscordMessage {
  id: string;
  channelId: string;
  userId: string;
  content: string;
  timestamp: number;
  metadata?: Record<string, any>;
}

export interface DiscordUser {
  id: string;
  name: string;
  avatar?: string;
}

export interface DiscordChannel {
  id: string;
  name: string;
  type: 'dm' | 'group' | 'channel';
}
