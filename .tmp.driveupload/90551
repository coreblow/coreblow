// @ts-nocheck
import { describe, it, expect, beforeEach } from 'vitest';
import { CircuitBreaker } from './circuit-breaker.js';
import { RateLimiter } from './rate-limiter.js';
import { debounce, throttle } from './debounce-throttle.js';

// ─── Circuit Breaker ───────────────────────────────────────────

describe('Circuit Breaker — Phase 24', () => {
    let cb: CircuitBreaker;

    beforeEach(() => {
        cb = new CircuitBreaker();
    });

    it('executes successfully when closed', async () => {
        const result = await cb.execute('api1', async () => 'success');
        expect(result).toBe('success');
        expect(cb.getState('api1')).toBe('closed');
    });

    it('opens circuit after failure threshold', async () => {
        const fail = async () => { throw new Error('boom'); };
        const config = { failureThreshold: 2 };

        await expect(cb.execute('api2', fail, config)).rejects.toThrow();
        expect(cb.getState('api2')).toBe('closed'); // 1 fail

        await expect(cb.execute('api2', fail, config)).rejects.toThrow();
        expect(cb.getState('api2')).toBe('open'); // 2 fails
    });

    it('fails fast when open without executing', async () => {
        const fail = async () => { throw new Error('boom'); };
        let executed = false;
        const config = { failureThreshold: 1 };

        await expect(cb.execute('api3', fail, config)).rejects.toThrow('boom');

        await expect(cb.execute('api3', async () => { executed = true; }, config))
            .rejects.toThrow('Circuit "api3" is open');

        expect(executed).toBe(false); // execution blocked
    });

    it('transitions to half-open after timeout', async () => {
        const fail = async () => { throw new Error('boom'); };
        const config = { failureThreshold: 1, resetTimeoutMs: 10 };

        await expect(cb.execute('api4', fail, config)).rejects.toThrow();
        expect(cb.getState('api4')).toBe('open');

        // wait for timeout
        await new Promise(r => setTimeout(r, 20));

        // State check should transition it to half-open
        expect(cb.getState('api4')).toBe('half-open');
    });

    it('closes from half-open after max success calls', async () => {
        const fail = async () => { throw new Error('boom'); };
        const success = async () => 'ok';
        const config = { failureThreshold: 1, resetTimeoutMs: 10, halfOpenMaxCalls: 2 };

        await expect(cb.execute('api5', fail, config)).rejects.toThrow();
        await new Promise(r => setTimeout(r, 20)); // transition to half-open

        await cb.execute('api5', success, config);
        expect(cb.getState('api5')).toBe('half-open'); // 1 success, need 2

        await cb.execute('api5', success, config);
        expect(cb.getState('api5')).toBe('closed'); // 2 successes -> closed
    });

    it('re-opens immediately if half-open call fails', async () => {
        const fail = async () => { throw new Error('boom'); };
        const config = { failureThreshold: 1, resetTimeoutMs: 10 };

        await expect(cb.execute('api6', fail, config)).rejects.toThrow();
        await new Promise(r => setTimeout(r, 20)); // half-open ready

        await expect(cb.execute('api6', fail, config)).rejects.toThrow('boom');
        expect(cb.getState('api6')).toBe('open'); // back to open
    });

    it('resets circuit manually', async () => {
        const fail = async () => { throw new Error('boom'); };
        await expect(cb.execute('api7', fail, { failureThreshold: 1 })).rejects.toThrow();

        expect(cb.getState('api7')).toBe('open');
        cb.reset('api7');
        expect(cb.getState('api7')).toBe('closed');
    });

    it('tracks stats properly', async () => {
        await cb.execute('api8', async () => 'ok');
        const stats = cb.getStats('api8');
        expect(stats?.successes).toBe(1);
        expect(stats?.totalCalls).toBe(1);
    });

    it('lists and counts circuits', async () => {
        await cb.execute('c1', async () => 'ok');
        await cb.execute('c2', async () => 'ok');

        expect(cb.count()).toBe(2);
        expect(cb.list()).toHaveLength(2);
        expect(cb.list()[0].key).toBe('c1');
    });

    it('getStats returns null for unknown circuit', () => {
        expect(cb.getStats('unknown')).toBeNull();
    });

    it('getState returns closed for unknown circuit', () => {
        expect(cb.getState('unknown')).toBe('closed');
    });

    it('reset returns false for unknown circuit', () => {
        expect(cb.reset('unknown')).toBe(false);
    });
});

// ─── Rate Limiter ──────────────────────────────────────────────

describe('Rate Limiter — Phase 24', () => {
    let limiter: RateLimiter;

    beforeEach(() => {
        limiter = new RateLimiter();
    });

    it('allows requests under limit', () => {
        const config = { maxTokens: 5, refillRate: 1 };
        expect(limiter.allow('req1', config, 1)).toBe(true);
        expect(limiter.allow('req1', config, 4)).toBe(true);
        expect(limiter.allow('req1', config, 1)).toBe(false); // empty
    });

    it('inspects without consuming', () => {
        const config = { maxTokens: 2, refillRate: 1 };
        const inspect = limiter.inspect('req2', config);

        expect(inspect.allowed).toBe(true);
        expect(inspect.remaining).toBe(2);

        limiter.allow('req2', config, 2); // consume all
        const emptyInspect = limiter.inspect('req2', config);
        expect(emptyInspect.allowed).toBe(false);
    });

    it('refills tokens over time', async () => {
        // max 2, refill 100/sec (1 token per 10ms)
        const config = { maxTokens: 2, refillRate: 100 };

        expect(limiter.allow('req3', config, 2)).toBe(true); // consume all
        expect(limiter.allow('req3', config, 1)).toBe(false); // empty

        await new Promise(r => setTimeout(r, 20)); // wait ~20ms = ~2 tokens refilled

        expect(limiter.allow('req3', config, 1)).toBe(true); // Should pass now
    });

    it('respects maxTokens during long waits', async () => {
        const config = { maxTokens: 1, refillRate: 100 };
        limiter.allow('req4', config, 1);
        await new Promise(r => setTimeout(r, 30)); // wait for 3 tokens

        const inspect = limiter.inspect('req4', config);
        expect(inspect.remaining).toBe(1); // capped at maxTokens
    });

    it('resets and clears limits', () => {
        const config = { maxTokens: 1, refillRate: 1 };
        limiter.allow('req5', config, 1);
        expect(limiter.allow('req5', config, 1)).toBe(false);

        limiter.reset('req5');
        expect(limiter.allow('req5', config, 1)).toBe(true); // reset recreates bucket

        limiter.clear();
        expect(limiter.allow('req5', config, 1)).toBe(true); // clear wiped it all
    });
});

// ─── Debounce & Throttle ───────────────────────────────────────

describe('Debounce & Throttle — Phase 24', () => {

    it('debounce delays execution', async () => {
        let calls = 0;
        const debounced = debounce(async () => calls++, 20);

        debounced().catch(() => {});
        debounced().catch(() => {});
        debounced().catch(() => {});

        expect(calls).toBe(0); // Not called yet
        await new Promise(r => setTimeout(r, 40));
        expect(calls).toBe(1); // Only called once
    });

    it('debounce cancel aborts execution', async () => {
        let calls = 0;
        const debounced = debounce(async () => calls++, 20);

        const p = debounced().catch(e => e.message); // expect cancel throw
        debounced.cancel();

        await new Promise(r => setTimeout(r, 40));
        expect(calls).toBe(0);
        expect(await p).toContain('cancelled manually');
    });

    it('throttle limits execution rate', async () => {
        let calls = 0;
        const throttled = throttle(async () => ++calls, 30);

        const r1 = await throttled(); // 1st call executes immediately
        expect(r1).toBe(1);
        expect(calls).toBe(1);

        const r2 = await throttled(); // 2nd call suppressed, returns lastResult
        expect(r2).toBe(1);
        expect(calls).toBe(1);

        await new Promise(r => setTimeout(r, 50)); // wait beyond throttle

        const r3 = await throttled(); // 3rd call executes fresh
        expect(r3).toBe(2);
        expect(calls).toBe(2);
    });

    it('throttle propagates initial errors', async () => {
        let calls = 0;
        const throttled = throttle(async () => {
            calls++;
            if (calls === 1) throw new Error('fail 1');
            return 'ok';
        }, 20);

        await expect(throttled()).rejects.toThrow('fail 1');
        await expect(throttled()).rejects.toThrow('fail 1'); // cached error during throttle window

        await new Promise(r => setTimeout(r, 30));

        await expect(throttled()).resolves.toBe('ok'); // fresh call succeeds
    });
});
