/**
 * CoreBlow Apply Patch Engine
 *
 * Apply unified diff patches with fuzzy matching, reverse-patch support,
 * multi-file patch handling, conflict detection, and dry-run mode.
 *
 * Equivalent: CoreBlow src/agents/apply-patch.ts (602 LOC)
 */

import { createChildLogger } from '../utils/logger.js';

const log = createChildLogger('apply-patch');

// ─── Types ────────────────────────────────────────────────────────

export interface PatchHunk {
    oldStart: number;
    oldCount: number;
    newStart: number;
    newCount: number;
    lines: string[];
    header?: string;
}

export interface PatchResult {
    success: boolean;
    output: string;
    hunksApplied: number;
    hunksTotal: number;
    fuzzyMatches: number;
    conflicts: PatchConflict[];
    stats: { additions: number; deletions: number; unchanged: number };
}

export interface PatchConflict {
    hunkIndex: number;
    expected: string[];
    actual: string[];
    line: number;
}

export interface MultiFilePatch {
    files: Array<{
        oldPath: string;
        newPath: string;
        hunks: PatchHunk[];
        isNew: boolean;
        isDeleted: boolean;
        mode?: string;
    }>;
}

export interface ApplyOptions {
    /** Fuzzy match tolerance (lines to search around target) */
    fuzz?: number;
    /** Whether this is a reverse patch (unapply) */
    reverse?: boolean;
    /** Dry run - don't modify content, just check */
    dryRun?: boolean;
    /** Strip path prefix depth (like patch -p1) */
    strip?: number;
    /** Ignore whitespace differences in context matching */
    ignoreWhitespace?: boolean;
}

// ─── Patch Parsing ────────────────────────────────────────────────

/** Parse a unified diff into hunks. */
export function parsePatch(diff: string): PatchHunk[] {
    const hunks: PatchHunk[] = [];
    const lines = diff.split('\n');
    let currentHunk: PatchHunk | null = null;

    for (const line of lines) {
        const hunkMatch = line.match(/^@@\s*-(\d+)(?:,(\d+))?\s*\+(\d+)(?:,(\d+))?\s*@@(.*)$/);
        if (hunkMatch) {
            if (currentHunk) hunks.push(currentHunk);
            currentHunk = {
                oldStart: parseInt(hunkMatch[1]!),
                oldCount: parseInt(hunkMatch[2] ?? '1'),
                newStart: parseInt(hunkMatch[3]!),
                newCount: parseInt(hunkMatch[4] ?? '1'),
                lines: [],
                header: hunkMatch[5]?.trim(),
            };
        } else if (currentHunk && (line.startsWith('+') || line.startsWith('-') || line.startsWith(' '))) {
            currentHunk.lines.push(line);
        }
    }
    if (currentHunk) hunks.push(currentHunk);
    return hunks;
}

/** Parse a multi-file unified diff */
export function parseMultiFilePatch(diff: string): MultiFilePatch {
    const files: MultiFilePatch['files'] = [];
    const fileSections = diff.split(/^diff --git /m).filter(Boolean);

    for (const section of fileSections) {
        const lines = section.split('\n');
        let oldPath = '';
        let newPath = '';
        let isNew = false;
        let isDeleted = false;
        let mode: string | undefined;

        for (const line of lines) {
            const oldMatch = line.match(/^--- a\/(.+)$/);
            const newMatch = line.match(/^\+\+\+ b\/(.+)$/);
            if (oldMatch) oldPath = oldMatch[1]!;
            if (newMatch) newPath = newMatch[1]!;
            if (line.startsWith('new file mode')) { isNew = true; mode = line.split(' ').pop(); }
            if (line.startsWith('deleted file mode')) { isDeleted = true; }
        }

        const hunks = parsePatch(section);

        if (newPath || oldPath) {
            files.push({
                oldPath: oldPath || newPath,
                newPath: newPath || oldPath,
                hunks,
                isNew,
                isDeleted,
                mode,
            });
        }
    }

    return { files };
}

// ─── Patch Application ────────────────────────────────────────────

/** Apply patch to file content. */
export function applyPatch(content: string, diff: string, options?: ApplyOptions): PatchResult {
    const opts: Required<ApplyOptions> = {
        fuzz: options?.fuzz ?? 5,
        reverse: options?.reverse ?? false,
        dryRun: options?.dryRun ?? false,
        strip: options?.strip ?? 0,
        ignoreWhitespace: options?.ignoreWhitespace ?? false,
    };

    let hunks = parsePatch(diff);
    if (hunks.length === 0) {
        return {
            success: false,
            output: content,
            hunksApplied: 0,
            hunksTotal: 0,
            fuzzyMatches: 0,
            conflicts: [],
            stats: { additions: 0, deletions: 0, unchanged: 0 },
        };
    }

    // Reverse patch: swap +/- lines and old/new starts
    if (opts.reverse) {
        hunks = hunks.map((h) => ({
            ...h,
            oldStart: h.newStart,
            oldCount: h.newCount,
            newStart: h.oldStart,
            newCount: h.oldCount,
            lines: h.lines.map((l) => {
                if (l.startsWith('+')) return '-' + l.slice(1);
                if (l.startsWith('-')) return '+' + l.slice(1);
                return l;
            }),
        }));
    }

    const contentLines = content.split('\n');
    let offset = 0;
    let applied = 0;
    let fuzzy = 0;
    const conflicts: PatchConflict[] = [];
    let additions = 0;
    let deletions = 0;
    let unchanged = 0;

    for (let hunkIdx = 0; hunkIdx < hunks.length; hunkIdx++) {
        const hunk = hunks[hunkIdx]!;
        const targetLine = hunk.oldStart - 1 + offset;
        const oldLines = hunk.lines
            .filter((l) => l.startsWith('-') || l.startsWith(' '))
            .map((l) => l.slice(1));

        // Count stats
        for (const line of hunk.lines) {
            if (line.startsWith('+')) additions++;
            else if (line.startsWith('-')) deletions++;
            else unchanged++;
        }

        // Try exact match first
        let matchOffset = 0;
        let matched = matchContext(contentLines, targetLine, oldLines, opts.ignoreWhitespace);

        // Fuzzy match within ±fuzz lines
        if (!matched) {
            for (let delta = -opts.fuzz; delta <= opts.fuzz; delta++) {
                if (delta === 0) continue;
                if (matchContext(contentLines, targetLine + delta, oldLines, opts.ignoreWhitespace)) {
                    matchOffset = delta;
                    matched = true;
                    fuzzy++;
                    break;
                }
            }
        }

        if (!matched) {
            conflicts.push({
                hunkIndex: hunkIdx,
                expected: oldLines,
                actual: contentLines.slice(
                    Math.max(0, targetLine),
                    Math.min(contentLines.length, targetLine + oldLines.length),
                ),
                line: targetLine + 1,
            });
            log.warn({ hunkIndex: hunkIdx, line: targetLine + 1 }, 'Hunk conflict');
            continue;
        }

        // Apply the hunk (unless dry run)
        if (!opts.dryRun) {
            const removeCount = hunk.lines.filter((l) => l.startsWith('-')).length;
            const addLines = hunk.lines
                .filter((l) => l.startsWith('+'))
                .map((l) => l.slice(1));
            contentLines.splice(targetLine + matchOffset, removeCount, ...addLines);
            offset += addLines.length - removeCount;
        }
        applied++;
    }

    const success = applied === hunks.length && conflicts.length === 0;
    if (success) {
        log.info({ hunksApplied: applied, fuzzyMatches: fuzzy }, 'Patch applied successfully');
    } else {
        log.warn({ applied, total: hunks.length, conflicts: conflicts.length }, 'Patch applied with issues');
    }

    return {
        success,
        output: opts.dryRun ? content : contentLines.join('\n'),
        hunksApplied: applied,
        hunksTotal: hunks.length,
        fuzzyMatches: fuzzy,
        conflicts,
        stats: { additions, deletions, unchanged },
    };
}

// ─── Match Helpers ────────────────────────────────────────────────

function matchContext(
    contentLines: string[],
    startLine: number,
    expectedLines: string[],
    ignoreWhitespace: boolean,
): boolean {
    if (startLine < 0 || startLine + expectedLines.length > contentLines.length) return false;

    for (let i = 0; i < expectedLines.length; i++) {
        const actual = contentLines[startLine + i]!;
        const expected = expectedLines[i]!;
        const matches = ignoreWhitespace
            ? actual.trim() === expected.trim()
            : actual === expected;
        if (!matches) return false;
    }
    return true;
}

// ─── Validation ───────────────────────────────────────────────────

/** Validate a patch diff string */
export function validatePatch(diff: string): { valid: boolean; errors: string[]; hunkCount: number } {
    const errors: string[] = [];
    const hunks = parsePatch(diff);

    if (hunks.length === 0) {
        errors.push('No hunks found in patch');
    }

    for (let i = 0; i < hunks.length; i++) {
        const hunk = hunks[i]!;
        if (hunk.lines.length === 0) {
            errors.push(`Hunk ${i + 1} has no lines`);
        }
        const addCount = hunk.lines.filter((l) => l.startsWith('+')).length;
        const removeCount = hunk.lines.filter((l) => l.startsWith('-')).length;
        const contextCount = hunk.lines.filter((l) => l.startsWith(' ')).length;

        if (removeCount + contextCount !== hunk.oldCount) {
            errors.push(`Hunk ${i + 1}: old line count mismatch (expected ${hunk.oldCount}, got ${removeCount + contextCount})`);
        }
        if (addCount + contextCount !== hunk.newCount) {
            errors.push(`Hunk ${i + 1}: new line count mismatch (expected ${hunk.newCount}, got ${addCount + contextCount})`);
        }
    }

    return { valid: errors.length === 0, errors, hunkCount: hunks.length };
}

/** Generate a summary of patch changes */
export function summarizePatch(diff: string): string {
    const hunks = parsePatch(diff);
    let additions = 0;
    let deletions = 0;

    for (const hunk of hunks) {
        additions += hunk.lines.filter((l) => l.startsWith('+')).length;
        deletions += hunk.lines.filter((l) => l.startsWith('-')).length;
    }

    return `${hunks.length} hunk(s): +${additions} -${deletions}`;
}
