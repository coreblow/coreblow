export class BashProcessRegistry { private procs = new Map<string, { pid: number; cmd: string; startedAt: number }>(); register(id: string, pid: number, cmd: string) { this.procs.set(id, { pid, cmd, startedAt: Date.now() }); } unregister(id: string) { this.procs.delete(id); } get(id: string) { return this.procs.get(id); } listAll() { return [...this.procs.entries()].map(([id, v]) => ({ id, ...v })); } }
