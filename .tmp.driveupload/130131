/**
 * MinimaxPortalAuth Types
 */
export interface MinimaxPortalAuthMessage {
  id: string;
  channelId: string;
  userId: string;
  content: string;
  timestamp: number;
  metadata?: Record<string, any>;
}

export interface MinimaxPortalAuthUser {
  id: string;
  name: string;
  avatar?: string;
}

export interface MinimaxPortalAuthChannel {
  id: string;
  name: string;
  type: 'dm' | 'group' | 'channel';
}
