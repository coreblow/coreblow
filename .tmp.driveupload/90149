#!/usr/bin/env bash
# CoreBlow Gateway — Installer Script
# Usage: curl -fsSL https://raw.githubusercontent.com/coreblow/coreblow/main/gateway/scripts/install.sh | bash

set -euo pipefail

REPO="https://github.com/coreblow/coreblow.git"
INSTALL_DIR="$HOME/coreblow-gateway"
MIN_NODE_VERSION=18

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}"
echo "  ██████╗ ██████╗ ██████╗ ███████╗██████╗ ██╗      ██████╗ ██╗    ██╗"
echo " ██╔════╝██╔═══██╗██╔══██╗██╔════╝██╔══██╗██║     ██╔═══██╗██║    ██║"
echo " ██║     ██║   ██║██████╔╝█████╗  ██████╔╝██║     ██║   ██║██║ █╗ ██║"
echo " ██║     ██║   ██║██╔══██╗██╔══╝  ██╔══██╗██║     ██║   ██║██║███╗██║"
echo " ╚██████╗╚██████╔╝██║  ██║███████╗██████╔╝███████╗╚██████╔╝╚███╔███╔╝"
echo "  ╚═════╝ ╚═════╝ ╚═╝  ╚═╝╚══════╝╚═════╝ ╚══════╝ ╚═════╝  ╚══╝╚══╝"
echo -e "${NC}"
echo "  AI Gateway Installer"
echo ""

# Check Node.js
check_node() {
  if ! command -v node &> /dev/null; then
    echo -e "${RED}✗ Node.js not found${NC}"
    echo "  Install Node.js 18+ from: https://nodejs.org"

    # Offer to install via nvm
    if command -v curl &> /dev/null; then
      read -p "  Install via nvm? (y/N): " install_nvm
      if [[ "$install_nvm" == "y" || "$install_nvm" == "Y" ]]; then
        echo -e "${BLUE}Installing nvm...${NC}"
        curl -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.39.7/install.sh | bash
        export NVM_DIR="$HOME/.nvm"
        source "$NVM_DIR/nvm.sh"
        nvm install --lts
        nvm use --lts
      else
        exit 1
      fi
    else
      exit 1
    fi
  fi

  NODE_VERSION=$(node -v | sed 's/v//' | cut -d. -f1)
  if [ "$NODE_VERSION" -lt "$MIN_NODE_VERSION" ]; then
    echo -e "${RED}✗ Node.js $MIN_NODE_VERSION+ required (found: v$(node -v))${NC}"
    exit 1
  fi
  echo -e "${GREEN}✓ Node.js $(node -v)${NC}"
}

# Check Git
check_git() {
  if ! command -v git &> /dev/null; then
    echo -e "${RED}✗ Git not found. Please install git.${NC}"
    exit 1
  fi
  echo -e "${GREEN}✓ Git $(git --version | awk '{print $3}')${NC}"
}

# Clone or update
install_gateway() {
  if [ -d "$INSTALL_DIR" ]; then
    echo -e "${YELLOW}→ Updating existing installation...${NC}"
    cd "$INSTALL_DIR"
    git pull origin main
  else
    echo -e "${BLUE}→ Cloning CoreBlow Gateway...${NC}"
    git clone "$REPO" "$INSTALL_DIR"
    cd "$INSTALL_DIR"
  fi

  cd gateway
  echo -e "${BLUE}→ Installing dependencies...${NC}"
  npm install

  echo -e "${GREEN}✓ Installation complete${NC}"
}

# Create config
setup_config() {
  COREBLOW_HOME="$HOME/.coreblow"
  mkdir -p "$COREBLOW_HOME/state" "$COREBLOW_HOME/auth" "$COREBLOW_HOME/skills"

  if [ ! -f "$COREBLOW_HOME/config.json" ]; then
    echo -e "${BLUE}→ Creating default config...${NC}"
    cat > "$COREBLOW_HOME/config.json" << 'EOF'
{
  "host": "127.0.0.1",
  "port": 3120,
  "agent": {
    "provider": "ollama",
    "model": "llama3.2"
  },
  "features": {
    "dashboard": true,
    "cron": true,
    "audit": true
  }
}
EOF
    echo -e "${GREEN}✓ Config created at $COREBLOW_HOME/config.json${NC}"
  else
    echo -e "${GREEN}✓ Config already exists${NC}"
  fi
}

# Main
echo "━━━ System Check ━━━"
check_node
check_git

echo ""
echo "━━━ Install ━━━"
install_gateway
setup_config

echo ""
echo -e "${GREEN}━━━ Done! ━━━${NC}"
echo ""
echo "  Start gateway:"
echo -e "    ${BLUE}cd $INSTALL_DIR/gateway${NC}"
echo -e "    ${BLUE}npx tsx src/index.ts gateway start${NC}"
echo ""
echo "  Run setup wizard:"
echo -e "    ${BLUE}npx tsx src/index.ts onboard${NC}"
echo ""
echo "  Check system:"
echo -e "    ${BLUE}npx tsx src/index.ts doctor${NC}"
echo ""
