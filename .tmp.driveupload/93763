/**
 * Wave 39: Auto-Reply Core
 * Tests for message chunking, command detection, and inbound context.
 */

import { describe, it, expect, beforeEach } from 'vitest';
import {
    chunkMessage,
    containsOpenCodeBlock,
    chunkMessageSmart
} from '../../src/auto-reply/chunk.js';
import {
    matchTrigger,
    isSlashCommand,
    parseSlashCommand,
    stripBotMention
} from '../../src/auto-reply/command-detection.js';
import {
    buildInboundContext
} from '../../src/auto-reply/inbound-context.js';

// Define simplified types for testing
interface ReplyTrigger {
    type: 'always' | 'dm' | 'mention' | 'command' | 'keyword' | 'regex';
    enabled: boolean;
    channels?: string[];
    pattern?: string;
    regex?: RegExp;
}

// Define a simplified InboundMessage for testing
interface TestInboundMessage {
    id: string;
    channel: string;
    content: string;
    author: string;
    attachments?: any[];
    replyTo?: string;
    threadId?: string;
    metadata?: Record<string, any>;
}

describe('Wave 39: Auto-Reply Core', () => {

    describe('Chunking Mechanics (chunk.ts)', () => {
        it('chunkMessage returns single chunk if within limit', () => {
            const chunks = chunkMessage('Short message', 'discord');
            expect(chunks).toEqual(['Short message']);
        });

        it('chunkMessage respects default platform length (4096)', () => {
            const longMsg = 'A'.repeat(5000);
            const chunks = chunkMessage(longMsg);
            expect(chunks).toHaveLength(2);
            expect(chunks[0].length).toBeLessThanOrEqual(4096);
        });

        it('chunkMessage respects discord limit (2000)', () => {
            const longMsg = 'A'.repeat(2500);
            const chunks = chunkMessage(longMsg, 'discord');
            expect(chunks).toHaveLength(2);
            expect(chunks[0].length).toBeLessThanOrEqual(2000);
        });

        it('chunkMessage prioritizes paragraph break', () => {
            const part1 = 'A'.repeat(1900);
            const part2 = 'B'.repeat(100);
            const msg = part1 + '\n\n' + part2;
            const chunks = chunkMessage(msg, 'discord');
            // The paragraph break is around 1900, which is > 2000 * 0.5 (1000)
            expect(chunks).toHaveLength(2);
            expect(chunks[0].endsWith('A')).toBe(true);
            expect(chunks[1].startsWith('B')).toBe(true);
        });

        it('chunkMessage prioritizes single newline over nothing', () => {
             const part1 = 'A'.repeat(1900);
             const part2 = 'B'.repeat(100);
             const msg = part1 + '\n' + part2;
             const chunks = chunkMessage(msg, 'discord');
             expect(chunks).toHaveLength(2);
             expect(chunks[1].startsWith('B')).toBe(true);
        });

        it('chunkMessage prioritizes sentence break over word break', () => {
            const part1 = 'A'.repeat(1900) + '.';
            const part2 = ' ' + 'B'.repeat(100);
            const msg = part1 + part2;
            const chunks = chunkMessage(msg, 'discord');
            expect(chunks).toHaveLength(2);
            expect(chunks[0].endsWith('.')).toBe(true);
        });

        it('chunkMessage prioritizes word break if no punctuation', () => {
            const part1 = 'A'.repeat(1900);
            const part2 = ' ' + 'B'.repeat(100);
            const msg = part1 + part2;
            const chunks = chunkMessage(msg, 'discord');
            expect(chunks[0].endsWith('A')).toBe(true);
        });

        it('chunkMessage falls back to hard cut', () => {
            const chars = 'A'.repeat(3000);
            const chunks = chunkMessage(chars, 'discord');
            expect(chunks[0]).toHaveLength(2000);
            expect(chunks[1]).toHaveLength(1000);
        });

        it('containsOpenCodeBlock detects unbalanced backticks', () => {
            expect(containsOpenCodeBlock('Hello ```code')).toBe(true);
            expect(containsOpenCodeBlock('Hello ```code```')).toBe(false);
            expect(containsOpenCodeBlock('```c1``` and ```c2')).toBe(true);
            expect(containsOpenCodeBlock('No code')).toBe(false);
        });

        it('chunkMessageSmart fixes split code blocks', () => {
            const part1 = 'Here is the code:\n```typescript\nconst a = ' + '1'.repeat(2100);
            const part2 = 'const b = 2;\n```';
            const msg = part1 + '\n\n' + part2;
            const chunks = chunkMessageSmart(msg, 'discord');

            expect(chunks).toHaveLength(2);
            expect(chunks[0].includes('```typescript')).toBe(true);
            expect(chunks[0].endsWith('```')).toBe(true);
            expect(chunks[1].startsWith('```\n')).toBe(true);
        });

        it('chunkMessageSmart works normally without code blocks', () => {
            const msg = 'A'.repeat(2500);
            const chunks = chunkMessageSmart(msg, 'discord');
            expect(chunks).toHaveLength(2);
            expect(chunks[0].includes('```')).toBe(false);
        });
    });

    describe('Command Detection (command-detection.ts)', () => {
        let msg: TestInboundMessage;

        beforeEach(() => {
            msg = { id: 'm1', channel: 'discord_general', content: 'test msg', author: 'user1' };
        });

        it('matchTrigger matches always type', () => {
            const trigger: ReplyTrigger = { type: 'always', enabled: true };
            expect(matchTrigger(msg as any, [trigger])).toBe(trigger);
        });

        it('matchTrigger respects enabled flag', () => {
            const trigger: ReplyTrigger = { type: 'always', enabled: false };
            expect(matchTrigger(msg as any, [trigger])).toBeNull();
        });

        it('matchTrigger matches channel filter', () => {
            msg.channel = 'discord_specific';
            const trigMatch: ReplyTrigger = { type: 'always', enabled: true, channels: ['discord_specific'] };
            const trigMiss: ReplyTrigger = { type: 'always', enabled: true, channels: ['other'] };
            expect(matchTrigger(msg as any, [trigMiss])).toBeNull();
            expect(matchTrigger(msg as any, [trigMatch])).toBe(trigMatch);
        });

        it('matchTrigger detects DM by prefix', () => {
            msg.channel = 'dm_user123';
            const trigger: ReplyTrigger = { type: 'dm', enabled: true };
            expect(matchTrigger(msg as any, [trigger])).toBe(trigger);
        });

        it('matchTrigger detects DM by metadata flag', () => {
            msg.channel = 'slack_generic';
            msg.metadata = { isDm: true };
            const trigger: ReplyTrigger = { type: 'dm', enabled: true };
            expect(matchTrigger(msg as any, [trigger])).toBe(trigger);
        });

        it('matchTrigger detects mention', () => {
            msg.content = 'Hello @coreblow how are you';
            const trigger: ReplyTrigger = { type: 'mention', enabled: true };
            expect(matchTrigger(msg as any, [trigger])).toBe(trigger);
        });

        it('matchTrigger ignores partial mention', () => {
            msg.content = 'Hello user@botstuff';
            const trigger: ReplyTrigger = { type: 'mention', enabled: true };
            expect(matchTrigger(msg as any, [trigger])).toBeNull();
        });

        it('matchTrigger detects slash command', () => {
            msg.content = '/hello there';
            const trigger: ReplyTrigger = { type: 'command', enabled: true };
            expect(matchTrigger(msg as any, [trigger])).toBe(trigger);
        });

        it('matchTrigger detects keyword via pattern', () => {
            msg.content = 'Can you help me';
            const trigger: ReplyTrigger = { type: 'keyword', pattern: 'help', enabled: true };
            expect(matchTrigger(msg as any, [trigger])).toBe(trigger);
        });

        it('matchTrigger detects regex', () => {
            msg.content = 'My order number is 12345';
            const trigger: ReplyTrigger = { type: 'regex', regex: /order\snum\w*\s+is\s+\d+/i, enabled: true };
            expect(matchTrigger(msg as any, [trigger])).toBe(trigger);
        });

        it('matchTrigger detects regex via string pattern', () => {
            msg.content = 'Code: ABC-123';
            const trigger: ReplyTrigger = { type: 'regex', pattern: '^code:\\s+\\w+-\\d+', enabled: true };
            expect(matchTrigger(msg as any, [trigger])).toBe(trigger);
        });

        it('matchTrigger safely catches invalid regex string', () => {
            msg.content = 'Testing [';
            const trigger: ReplyTrigger = { type: 'regex', pattern: '[', enabled: true };
            expect(matchTrigger(msg as any, [trigger])).toBeNull();
        });

        it('isSlashCommand identifies valid slash commands', () => {
            expect(isSlashCommand('/help')).toBe(true);
            expect(isSlashCommand('/config get')).toBe(true);
            expect(isSlashCommand('/a')).toBe(true);
        });

        it('isSlashCommand rejects non-commands', () => {
            expect(isSlashCommand('help')).toBe(false);
            expect(isSlashCommand('/')).toBe(false); // Too short
            expect(isSlashCommand('// comment')).toBe(false); // Double slash is often code comments
        });

        it('parseSlashCommand extracts command and arguments', () => {
            expect(parseSlashCommand('/set volume 11')).toEqual({
                command: 'set',
                args: ['volume', '11'],
                raw: '/set volume 11'
            });
        });

        it('parseSlashCommand normalizes command to lowercase', () => {
            expect(parseSlashCommand('/HELP me')).toEqual({
                command: 'help',
                args: ['me'],
                raw: '/HELP me'
            });
        });

        it('parseSlashCommand returns null on invalid command', () => {
            expect(parseSlashCommand('not a command')).toBeNull();
        });

        it('stripBotMention removes @coreblow', () => {
            expect(stripBotMention('@coreblow hi')).toBe('hi');
            expect(stripBotMention('hello @coreblow')).toBe('hello');
            expect(stripBotMention('what about @coreblow now')).toBe('what about now');
        });

        it('stripBotMention removes @bot', () => {
            expect(stripBotMention('@bot hello')).toBe('hello');
        });

        it('stripBotMention ignores unrelated at-signs', () => {
            expect(stripBotMention('user@domain.com @bot')).toBe('user@domain.com');
        });
    });

    describe('Inbound Context (inbound-context.ts)', () => {
        it('buildInboundContext strips mention to create cleanContent', () => {
            const ctx = buildInboundContext({ content: '@coreblow what is this?' } as any);
            expect(ctx.cleanContent).toBe('what is this?');
            expect(ctx.mentionsBots).toBe(true);
        });

        it('buildInboundContext detects questions via punctuation', () => {
            const ctx = buildInboundContext({ content: 'Are you there?' } as any);
            expect(ctx.isQuestion).toBe(true);
        });

        it('buildInboundContext detects questions via starter word', () => {
            const ctx = buildInboundContext({ content: 'which one is best' } as any);
            expect(ctx.isQuestion).toBe(true);
            const ctxIndo = buildInboundContext({ content: 'bagaimana ini' } as any);
            expect(ctxIndo.isQuestion).toBe(true);
        });

        it('buildInboundContext marks non-questions as false', () => {
            const ctx = buildInboundContext({ content: 'Just stating facts.' } as any);
            expect(ctx.isQuestion).toBe(false);
        });

        it('buildInboundContext detects attachments', () => {
            const ctxT = buildInboundContext({ content: 'pic', attachments: [{ url: 'x' }] } as any);
            expect(ctxT.hasAttachments).toBe(true);

            const ctxF = buildInboundContext({ content: 'text', attachments: [] } as any);
            expect(ctxF.hasAttachments).toBe(false);
        });

        it('buildInboundContext flags isReply if replyTo is present', () => {
            const ctxT = buildInboundContext({ content: 'thx', replyTo: 'msg-id' } as any);
            expect(ctxT.isReply).toBe(true);

            const ctxF = buildInboundContext({ content: 'thx' } as any);
            expect(ctxF.isReply).toBe(false);
        });

        it('buildInboundContext flags isThread if threadId is present', () => {
            const ctx = buildInboundContext({ content: 'reply in thread', threadId: 'thread-123' } as any);
            expect(ctx.isThread).toBe(true);
        });

        it('buildInboundContext estimates tokens', () => {
            const text = 'This is exactly twenty chars'; // length = 28
            const ctx = buildInboundContext({ content: text } as any);
            expect(ctx.estimatedTokens).toBe(Math.ceil(28 / 4)); // 7
        });

        it('buildInboundContext detects basic languages', () => {
            // Japanese
            const ctxJa = buildInboundContext({ content: 'こんにちは' } as any);
            expect(ctxJa.language).toBe('ja');

            // Korean
            const ctxKo = buildInboundContext({ content: '안녕하세요' } as any);
            expect(ctxKo.language).toBe('ko');

            // Russian
            const ctxRu = buildInboundContext({ content: 'привет' } as any);
            expect(ctxRu.language).toBe('ru');

            // Indonesian
            const ctxId = buildInboundContext({ content: 'ini adalah buku dan itu pena' } as any);
            expect(ctxId.language).toBe('id');

            // English (fallback)
            const ctxEn = buildInboundContext({ content: 'Hello there' } as any);
            expect(ctxEn.language).toBe('en');
        });
    });
});
