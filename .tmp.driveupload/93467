import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
import { CircuitBreaker } from '../../src/infra/circuit-breaker.js';
import { RetryPolicy } from '../../src/infra/retry-policy.js';

describe('Wave 51: Resilience Infrastructure', () => {

    describe('CircuitBreaker', () => {
        let cb: CircuitBreaker;

        beforeEach(() => {
            cb = new CircuitBreaker();
            vi.useFakeTimers();
        });

        afterEach(() => {
            vi.useRealTimers();
        });

        it('starts in closed state and tracks successes', async () => {
            const result = await cb.execute('test-1', async () => 'success');
            expect(result).toBe('success');

            const stats = cb.getStats('test-1');
            expect(stats?.state).toBe('closed');
            expect(stats?.successes).toBe(1);
            expect(stats?.failures).toBe(0);
        });

        it('opens circuit after reaching failure threshold', async () => {
            const failFn = async () => { throw new Error('fail'); };

            // Execute 5 times (default threshold)
            for (let i = 0; i < 5; i++) {
                await expect(cb.execute('test-2', failFn)).rejects.toThrow('fail');
            }

            // Circuit should now be open
            expect(cb.getState('test-2')).toBe('open');

            // 6th execution should fail fast with circuit open error
            await expect(cb.execute('test-2', failFn)).rejects.toThrow('Circuit "test-2" is open');
        });

        it('transitions from open to half-open after reset timeout', async () => {
            const failFn = async () => { throw new Error('fail'); };

            // Open circuit
            for (let i = 0; i < 2; i++) {
                await cb.execute('test-3', failFn, { failureThreshold: 2 }).catch(() => {});
            }
            expect(cb.getState('test-3')).toBe('open');

            // Wait for reset timeout (default 30,000ms)
            await vi.advanceTimersByTimeAsync(30_001);

            // Accessing the circuit should transition it to half-open
            expect(cb.getState('test-3')).toBe('half-open');

            // An execution in half-open state that succeeds
            await expect(cb.execute('test-3', async () => 'ok')).resolves.toBe('ok');
        });

        it('transitions from half-open to closed after successful probes', async () => {
            const failFn = async () => { throw new Error('fail'); };

            // Open circuit
            for (let i = 0; i < 1; i++) {
                await cb.execute('test-4', failFn, { failureThreshold: 1, halfOpenMaxCalls: 2 }).catch(() => {});
            }

            await vi.advanceTimersByTimeAsync(30_001);
            expect(cb.getState('test-4')).toBe('half-open');

            // 1st success
            await cb.execute('test-4', async () => 'ok');
            expect(cb.getState('test-4')).toBe('half-open'); // Needs 2 successes

            // 2nd success
            await cb.execute('test-4', async () => 'ok');
            expect(cb.getState('test-4')).toBe('closed'); // Fully recovered
        });

        it('re-opens circuit if failure occurs while half-open', async () => {
            const failFn = async () => { throw new Error('fail'); };

            // Open circuit
            for (let i = 0; i < 1; i++) {
                await cb.execute('test-5', failFn, { failureThreshold: 1 }).catch(() => {});
            }

            await vi.advanceTimersByTimeAsync(30_001);
            expect(cb.getState('test-5')).toBe('half-open');

            // A failure in half-open state immediately re-opens the circuit
            await cb.execute('test-5', failFn).catch(() => {});
            expect(cb.getState('test-5')).toBe('open');
        });

        it('can be manually reset', async () => {
            const failFn = async () => { throw new Error('fail'); };

            for (let i = 0; i < 5; i++) {
                await cb.execute('test-6', failFn).catch(() => {});
            }
            expect(cb.getState('test-6')).toBe('open');

            cb.reset('test-6');
            expect(cb.getState('test-6')).toBe('closed');

            // Should be able to execute again
            await expect(cb.execute('test-6', async () => 'ok')).resolves.toBe('ok');
        });

        it('tracks multiple circuits independently', async () => {
            await cb.execute('c1', async () => 'ok');
            await cb.execute('c2', async () => { throw new Error('X'); }, { failureThreshold: 1 }).catch(() => {});

            expect(cb.getState('c1')).toBe('closed');
            expect(cb.getState('c2')).toBe('open');

            expect(cb.count()).toBe(2);
            expect(cb.list()).toHaveLength(2);
        });
    });

    describe('RetryPolicy', () => {
        beforeEach(() => {
            vi.useFakeTimers();
        });

        afterEach(() => {
            vi.useRealTimers();
        });

        it('succeeds on first try without delays', async () => {
            const policy = new RetryPolicy();
            const fn = vi.fn().mockResolvedValue('success');

            const result = await policy.execute(fn);
            expect(result.success).toBe(true);
            expect(result.data).toBe('success');
            expect(result.attempts).toBe(1);
            expect(fn).toHaveBeenCalledTimes(1);
        });

        it('retries on failure and succeeds eventually', async () => {
            const policy = new RetryPolicy({ baseDelayMs: 100, jitter: false });

            let calls = 0;
            const fn = vi.fn().mockImplementation(async () => {
                calls++;
                if (calls < 3) throw new Error('temporary fail');
                return 'success';
            });

            // Start the execute promise without awaiting it yet
            const p = policy.execute(fn);

            // Wait for next tick so it can fail and set the first timeout
            await Promise.resolve();
            // Advance past first delay
            await vi.advanceTimersByTimeAsync(100);

            await Promise.resolve();
            // Advance past second delay (multiplier = 2 by default, so 200ms)
            await vi.advanceTimersByTimeAsync(200);

            const result = await p;
            expect(result.success).toBe(true);
            expect(result.data).toBe('success');
            expect(result.attempts).toBe(3);
            expect(fn).toHaveBeenCalledTimes(3);
        });

        it('exhausts all retries and returns false if it keeps failing', async () => {
            const policy = new RetryPolicy({ maxRetries: 2, baseDelayMs: 50, jitter: false });
            const fn = vi.fn().mockRejectedValue(new Error('fatal fail'));

            const p = policy.execute(fn);

            // We expect 3 total attempts (attempt 0, 1, 2)
            for (let i = 0; i < 3; i++) {
                await Promise.resolve();
                await vi.runAllTimersAsync();
            }

            const result = await p;
            expect(result.success).toBe(false);
            expect(result.error?.message).toBe('fatal fail');
            expect(result.attempts).toBe(3); // 1 initial + 2 retries
            expect(fn).toHaveBeenCalledTimes(3);
        });

        it('respects retryOn predicate to fail fast', async () => {
            const policy = new RetryPolicy({
                maxRetries: 5,
                retryOn: (err: any) => err.message !== 'stop'
            });

            const fn = vi.fn().mockRejectedValue(new Error('stop'));

            const result = await policy.execute(fn);
            // Should not retry because retryOn returns false
            expect(result.success).toBe(false);
            expect(result.attempts).toBe(1); // Only initial attempt
            expect(fn).toHaveBeenCalledTimes(1);
        });

        it('provides preset configurations', () => {
            const aggressive = RetryPolicy.aggressive();
            const conservative = RetryPolicy.conservative();
            const none = RetryPolicy.noRetry();

            // Just test they instantiate without error and record stats properly
            expect(aggressive.getStats().totalCalls).toBe(0);
            expect(conservative.getStats().totalCalls).toBe(0);
            expect(none.getStats().totalCalls).toBe(0);
        });

        it('calculates jitter delays correctly (internal)', async () => {
             const policy = new RetryPolicy({ baseDelayMs: 100, jitter: true });
             const fn = vi.fn().mockRejectedValue(new Error('fail'));

             // Just test that passing jitter: true does not cause errors
             // Precise jitter testing requires mocking Math.random which can be flaky
             // so we just verify functionality.
             const p = policy.execute(fn);
             // Let it spin through all retries
             for (let i = 0; i < 10; i++) {
                 await Promise.resolve();
                 await vi.runAllTimersAsync();
             }
             const result = await p;
             expect(result.success).toBe(false);
        });
    });
});
