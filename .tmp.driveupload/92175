/**
 * gateway/session-lifecycle-state.ts
 * Session state machine — tracks session lifecycle transitions.
 */

export type SessionLifecycleState =
    | 'created'
    | 'idle'
    | 'active'
    | 'waiting_approval'
    | 'waiting_tool'
    | 'streaming'
    | 'completed'
    | 'archived'
    | 'error';

/** Valid state transitions. */
const TRANSITIONS: Record<SessionLifecycleState, SessionLifecycleState[]> = {
    created: ['idle', 'active', 'error'],
    idle: ['active', 'archived', 'error'],
    active: ['streaming', 'waiting_approval', 'waiting_tool', 'completed', 'idle', 'error'],
    waiting_approval: ['active', 'completed', 'error'],
    waiting_tool: ['active', 'completed', 'error'],
    streaming: ['active', 'completed', 'idle', 'error'],
    completed: ['idle', 'archived'],
    archived: [], // terminal
    error: ['idle', 'archived'],
};

export class SessionLifecycle {
    private _state: SessionLifecycleState = 'created';
    private _history: Array<{ from: SessionLifecycleState; to: SessionLifecycleState; at: number }> = [];

    get state(): SessionLifecycleState {
        return this._state;
    }

    get history() {
        return [...this._history];
    }

    /** Attempt a state transition. Returns true if successful. */
    transition(to: SessionLifecycleState): boolean {
        const allowed = TRANSITIONS[this._state];
        if (!allowed.includes(to)) {
            return false;
        }

        this._history.push({ from: this._state, to, at: Date.now() });
        this._state = to;
        return true;
    }

    /** Check if a transition is valid without performing it. */
    canTransition(to: SessionLifecycleState): boolean {
        return TRANSITIONS[this._state].includes(to);
    }

    /** Is the session in a terminal state? */
    get isTerminal(): boolean {
        return this._state === 'archived';
    }

    /** Is the session actively processing? */
    get isActive(): boolean {
        return this._state === 'active' || this._state === 'streaming';
    }

    /** Is the session waiting for external input? */
    get isWaiting(): boolean {
        return this._state === 'waiting_approval' || this._state === 'waiting_tool';
    }
}
