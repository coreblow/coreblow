/**
 * Whatsapp Types
 */
export interface WhatsappMessage {
  id: string;
  channelId: string;
  userId: string;
  content: string;
  timestamp: number;
  metadata?: Record<string, any>;
}

export interface WhatsappUser {
  id: string;
  name: string;
  avatar?: string;
}

export interface WhatsappChannel {
  id: string;
  name: string;
  type: 'dm' | 'group' | 'channel';
}
