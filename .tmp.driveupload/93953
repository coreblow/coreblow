import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
import * as fs from 'node:fs';
import { HooksEngine } from '../../src/hooks/engine.js';
import { FlowEngine } from '../../src/flows/flow-engine.js';
import { CronScheduler } from '../../src/cron/scheduler.js';
import { enqueueCommand, getNextCommand, startCommand, completeCommand, clearQueue } from '../../src/process/command-queue.js';
import { AttachmentPipeline } from '../../src/media/attachments.js';

describe('Wave 50: E2E System Integration', () => {

    beforeEach(() => {
        vi.useFakeTimers();
        clearQueue();
    });

    afterEach(() => {
        vi.useRealTimers();
        vi.restoreAllMocks();
    });

    it('simulates a complete system boot, event flow, and teardown', async () => {
        // 1. Initialize Subsystems
        const hooks = new HooksEngine();
        const flows = new FlowEngine();
        const cron = new CronScheduler({ enabled: true });
        const media = new AttachmentPipeline();

        let systemStats = { booted: false, jobsRun: 0, mediaProcessed: 0, commandsExecuted: 0 };

        // 2. Register Hooks (Mocking Plugin lifecycle)
        hooks.register({
            id: 'plugin-boot',
            name: 'Bootstrapper',
            source: 'plugin',
            metadata: { events: ['system:boot'], priority: 1 },
            handler: async () => { systemStats.booted = true; },
            enabled: true
        });

        hooks.register({
            id: 'job-listener',
            name: 'Job Tracker',
            source: 'plugin',
            metadata: { events: ['cron:job:done'] },
            handler: async () => { systemStats.jobsRun++; },
            enabled: true
        });

        hooks.register({
            id: 'media-listener',
            name: 'Media Tracker',
            source: 'plugin',
            metadata: { events: ['media:processed'] },
            handler: async () => { systemStats.mediaProcessed++; },
            enabled: true
        });

        // 3. System Boot Phase
        await hooks.emit('system:boot');
        expect(systemStats.booted).toBe(true);

        // 4. Cron Job Scheduling
        const cronExecutor = vi.fn().mockImplementation(async (j) => {
            await hooks.emit('cron:job:done', { jobId: j.id });
            return { success: true };
        });
        cron.setExecutor(cronExecutor);

        cron.createJob({
            name: 'SystemHealth',
            schedule: 'every 1 hour',
            action: 'custom',
            payload: ''
        });

        // Advance 1 hour
        await vi.advanceTimersByTimeAsync(3600_000);
        expect(systemStats.jobsRun).toBe(1);

        // 5. Process Queue Integration
        enqueueCommand('e2e-cmd1', 'system.health_check', 'high');
        enqueueCommand('e2e-cmd2', 'system.cleanup', 'normal');

        const cmd1 = getNextCommand();
        expect(cmd1?.id).toBe('e2e-cmd1');

        startCommand(cmd1!.id);
        completeCommand(cmd1!.id, 'OK');
        systemStats.commandsExecuted++;

        // 6. Media Pipeline + Flow Engine
        // (Mocking an incoming message with media that starts a flow)
        const processedMedia = await media.process({
            filename: 'photo.jpg', mimeType: 'image/jpeg', size: 100, channel: 'discord', buffer: Buffer.from('data')
        });
        if (processedMedia) {
            await hooks.emit('media:processed', { mediaId: processedMedia.id });
        }

        expect(systemStats.mediaProcessed).toBe(1);

        const flowInstance = await flows.start({
            name: 'ImageAnalyzer',
            description: 'Analyzes an image',
            initialStep: 'init',
            steps: [{ id: 'init', prompt: 'Analyzing image...' }]
        }, 'discord_user_1');
        expect(flowInstance.state).toBe('waiting_input');

        // 7. Teardown
        cron.destroy();
        hooks.clear();
        media.clearCache();
        clearQueue();

        expect(systemStats.jobsRun).toBe(1);
        expect(systemStats.commandsExecuted).toBe(1);
    });
});
