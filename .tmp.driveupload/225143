/**
 * utils/rate-utils.ts
 */
export function tokensPerSecond(tokens: number, durationMs: number): number { return durationMs > 0 ? Math.round(tokens / (durationMs / 1000)) : 0; } export function costPerToken(totalCost: number, totalTokens: number): number { return totalTokens > 0 ? totalCost / totalTokens : 0; }
