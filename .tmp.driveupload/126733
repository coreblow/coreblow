/**
 * CopilotProxy Types
 */
export interface CopilotProxyMessage {
  id: string;
  channelId: string;
  userId: string;
  content: string;
  timestamp: number;
  metadata?: Record<string, any>;
}

export interface CopilotProxyUser {
  id: string;
  name: string;
  avatar?: string;
}

export interface CopilotProxyChannel {
  id: string;
  name: string;
  type: 'dm' | 'group' | 'channel';
}
