// sessions-patch.ts
import { globalSessionManager } from "./session-utils.js";

export function patchSessionMetadata(sessionKey: string, patch: Record<string, any>): boolean {
    const session = globalSessionManager.get(sessionKey);
    if (!session) return false;

    session.metadata = { ...session.metadata, ...patch };
    globalSessionManager.touch(sessionKey);
    return true;
}
