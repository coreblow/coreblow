import { describe, it, expect, vi } from "vitest";
import { appendCronRunLog, readCronRunLogEntries } from "../../src/cron/run-log.js";
import * as fs from "node:fs/promises";
import path from "node:path";
import os from "node:os";

vi.mock("node:fs/promises", () => {
  return {
    mkdir: vi.fn().mockResolvedValue(undefined),
    readFile: vi.fn(),
    appendFile: vi.fn().mockResolvedValue(undefined),
    stat: vi.fn().mockResolvedValue({ size: 100 }),
    writeFile: vi.fn().mockResolvedValue(undefined),
    chmod: vi.fn().mockReturnValue({ catch: vi.fn() })
  };
});

describe("cron run-log", () => {
  const storePath = path.join(os.homedir(), "mock");
  const jobId = "job1";

  it("appends multiple entries correctly", async () => {
    vi.mocked(fs.readFile).mockResolvedValue('{"ts": 1}\n{"ts": 2}\n');
    await appendCronRunLog("/mock/job1.log", { ts: 3 } as any);

    expect(fs.appendFile).toHaveBeenCalled();
  });

  it("reads cron run logs", async () => {
    vi.mocked(fs.readFile).mockResolvedValue('{"ts": 1}\n{"ts": 2}\n');
    vi.mocked(fs.stat).mockResolvedValue({ size: 100 } as any);
    const logs = await readCronRunLogEntries("/mock/job1.log");

    expect(logs).toBeInstanceOf(Array);
  });
});
