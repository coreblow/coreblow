/**
 * CoreBlow Security — AccessControl (Tool Profiles) Test Suite
 *
 * Covers: canUseTool() with access profiles (full/read-only/no-exec),
 * isToolAllowed() with tool profiles (minimal/coding/messaging/full),
 * group expansion, allow/deny overrides, byProvider config,
 * getProfile(), getEffectiveProfile(), getAllowedTools(), and edge cases.
 */
import { describe, it, expect, vi, beforeEach } from 'vitest';

vi.mock('../utils/logger.js', () => ({
    createChildLogger: () => ({
        info: vi.fn(), warn: vi.fn(), error: vi.fn(), debug: vi.fn(),
    }),
}));

import { AccessControl, type ToolProfile, type AccessProfile } from './tool-profiles.js';

describe('AccessControl', () => {
    // ─── canUseTool() — Access Profiles ─────────────────────────

    describe('canUseTool() — access profiles', () => {
        let ac: AccessControl;

        beforeEach(() => {
            ac = new AccessControl();
        });

        it('full profile allows everything', () => {
            expect(ac.canUseTool('full', 'exec')).toBe(true);
            expect(ac.canUseTool('full', 'process')).toBe(true);
            expect(ac.canUseTool('full', 'web_search')).toBe(true);
            expect(ac.canUseTool('full', 'anything')).toBe(true);
        });

        it('read-only profile allows only listed tools', () => {
            expect(ac.canUseTool('read-only', 'web_search')).toBe(true);
            expect(ac.canUseTool('read-only', 'web_fetch')).toBe(true);
            expect(ac.canUseTool('read-only', 'image')).toBe(true);
            expect(ac.canUseTool('read-only', 'session_status')).toBe(true);
            expect(ac.canUseTool('read-only', 'exec')).toBe(false);
            expect(ac.canUseTool('read-only', 'apply_patch')).toBe(false);
        });

        it('no-exec profile blocks exec and process', () => {
            expect(ac.canUseTool('no-exec', 'exec')).toBe(false);
            expect(ac.canUseTool('no-exec', 'process')).toBe(false);
        });

        it('no-exec profile allows other tools', () => {
            expect(ac.canUseTool('no-exec', 'web_search')).toBe(true);
            expect(ac.canUseTool('no-exec', 'message')).toBe(true);
        });
    });

    // ─── isToolAllowed() — Tool Profiles ────────────────────────

    describe('isToolAllowed() — tool profiles', () => {
        it('full profile allows everything', () => {
            const ac = new AccessControl({ profile: 'full' });
            expect(ac.isToolAllowed('exec')).toBe(true);
            expect(ac.isToolAllowed('anything')).toBe(true);
        });

        it('minimal profile allows only session_status', () => {
            const ac = new AccessControl({ profile: 'minimal' });
            expect(ac.isToolAllowed('session_status')).toBe(true);
            expect(ac.isToolAllowed('exec')).toBe(false);
            expect(ac.isToolAllowed('web_search')).toBe(false);
        });

        it('coding profile allows filesystem, runtime, and related tools', () => {
            const ac = new AccessControl({ profile: 'coding' });
            expect(ac.isToolAllowed('exec')).toBe(true);
            expect(ac.isToolAllowed('apply_patch')).toBe(true);
            expect(ac.isToolAllowed('process')).toBe(true);
            expect(ac.isToolAllowed('browser')).toBe(true);
            expect(ac.isToolAllowed('canvas')).toBe(true);
            expect(ac.isToolAllowed('web_search')).toBe(true);
            expect(ac.isToolAllowed('image')).toBe(true);
        });

        it('coding profile blocks messaging tools', () => {
            const ac = new AccessControl({ profile: 'coding' });
            expect(ac.isToolAllowed('message')).toBe(false);
        });

        it('messaging profile allows messaging tools', () => {
            const ac = new AccessControl({ profile: 'messaging' });
            expect(ac.isToolAllowed('message')).toBe(true);
            expect(ac.isToolAllowed('sessions_send')).toBe(true);
            expect(ac.isToolAllowed('sessions_list')).toBe(true);
            expect(ac.isToolAllowed('session_status')).toBe(true);
        });

        it('messaging profile blocks exec', () => {
            const ac = new AccessControl({ profile: 'messaging' });
            expect(ac.isToolAllowed('exec')).toBe(false);
            expect(ac.isToolAllowed('apply_patch')).toBe(false);
        });
    });

    // ─── Allow / Deny Overrides ─────────────────────────────────

    describe('allow / deny overrides', () => {
        it('allow list adds tools to a profile', () => {
            const ac = new AccessControl({ profile: 'minimal', allow: ['web_search'] });
            expect(ac.isToolAllowed('session_status')).toBe(true); // from profile
            expect(ac.isToolAllowed('web_search')).toBe(true); // from allow
            expect(ac.isToolAllowed('exec')).toBe(false); // not in either
        });

        it('deny list blocks tools even in full profile', () => {
            const ac = new AccessControl({ profile: 'full', deny: ['exec', 'process'] });
            expect(ac.isToolAllowed('exec')).toBe(false);
            expect(ac.isToolAllowed('process')).toBe(false);
            expect(ac.isToolAllowed('web_search')).toBe(true);
        });

        it('deny overrides allow', () => {
            const ac = new AccessControl({ profile: 'minimal', allow: ['exec'], deny: ['exec'] });
            expect(ac.isToolAllowed('exec')).toBe(false);
        });
    });

    // ─── byProvider ─────────────────────────────────────────────

    describe('byProvider overrides', () => {
        it('uses provider-specific profile', () => {
            const ac = new AccessControl({
                profile: 'minimal',
                byProvider: {
                    'openai': { profile: 'coding' },
                    'anthropic': { profile: 'full' },
                },
            });

            expect(ac.isToolAllowed('exec', 'openai')).toBe(true); // coding profile
            expect(ac.isToolAllowed('anything', 'anthropic')).toBe(true); // full profile
            expect(ac.isToolAllowed('exec')).toBe(false); // default minimal
        });

        it('falls back to default for unknown provider', () => {
            const ac = new AccessControl({
                profile: 'minimal',
                byProvider: { 'openai': { profile: 'coding' } },
            });

            expect(ac.isToolAllowed('exec', 'unknown-provider')).toBe(false);
        });
    });

    // ─── getProfile() ───────────────────────────────────────────

    describe('getProfile()', () => {
        it('returns full profile rules', () => {
            const ac = new AccessControl();
            const rules = ac.getProfile('full');
            expect(rules.canExec).toBe(true);
            expect(rules.canWriteFiles).toBe(true);
            expect(rules.allowedTools).toBe('all');
        });

        it('returns read-only profile rules', () => {
            const ac = new AccessControl();
            const rules = ac.getProfile('read-only');
            expect(rules.canExec).toBe(false);
            expect(rules.canWriteFiles).toBe(false);
            expect(Array.isArray(rules.allowedTools)).toBe(true);
        });

        it('returns no-exec profile rules', () => {
            const ac = new AccessControl();
            const rules = ac.getProfile('no-exec');
            expect(rules.canExec).toBe(false);
            expect(rules.canWriteFiles).toBe(true);
        });
    });

    // ─── getEffectiveProfile() ──────────────────────────────────

    describe('getEffectiveProfile()', () => {
        it('returns default profile when no provider', () => {
            const ac = new AccessControl({ profile: 'coding' });
            expect(ac.getEffectiveProfile()).toBe('coding');
        });

        it('returns provider-specific profile', () => {
            const ac = new AccessControl({
                profile: 'minimal',
                byProvider: { 'openai': { profile: 'full' } },
            });
            expect(ac.getEffectiveProfile('openai')).toBe('full');
        });

        it('returns default for unknown provider', () => {
            const ac = new AccessControl({ profile: 'minimal' });
            expect(ac.getEffectiveProfile('unknown')).toBe('minimal');
        });
    });

    // ─── getAllowedTools() ──────────────────────────────────────

    describe('getAllowedTools()', () => {
        it('returns ["*"] for full profile', () => {
            const ac = new AccessControl({ profile: 'full' });
            expect(ac.getAllowedTools()).toEqual(['*']);
        });

        it('returns expanded tool list for minimal profile', () => {
            const ac = new AccessControl({ profile: 'minimal' });
            const tools = ac.getAllowedTools();
            expect(tools).toContain('session_status');
            expect(tools.length).toBe(1);
        });

        it('expands groups for coding profile', () => {
            const ac = new AccessControl({ profile: 'coding' });
            const tools = ac.getAllowedTools();
            expect(tools).toContain('exec');
            expect(tools).toContain('apply_patch');
            expect(tools).toContain('process');
            expect(tools).toContain('browser');
            expect(tools).toContain('sessions_list');
            // Should not contain group: prefixes
            expect(tools.every(t => !t.startsWith('group:'))).toBe(true);
        });

        it('returns deduplicated tools', () => {
            const ac = new AccessControl({ profile: 'coding' });
            const tools = ac.getAllowedTools();
            const unique = [...new Set(tools)];
            expect(tools.length).toBe(unique.length);
        });

        it('accepts a specific profile parameter', () => {
            const ac = new AccessControl({ profile: 'full' });
            const minTools = ac.getAllowedTools('minimal');
            expect(minTools).toContain('session_status');
            expect(minTools.length).toBe(1);
        });
    });

    // ─── Constructor Defaults ───────────────────────────────────

    describe('constructor defaults', () => {
        it('defaults to full profile', () => {
            const ac = new AccessControl();
            expect(ac.getEffectiveProfile()).toBe('full');
        });
    });
});
