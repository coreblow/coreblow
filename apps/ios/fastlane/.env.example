# App Store Connect API key (pick one approach)
#
# Recommended (use the downloaded .p8 directly):
# ASC_KEY_ID=XXXXXXXXXX
# ASC_ISSUER_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# ASC_KEY_PATH=/path/to/AuthKey_XXXXXXXXXX.p8
#
# Alternative (JSON key file):
# APP_STORE_CONNECT_API_KEY_PATH=/path/to/AuthKey_XXXXXX.p8.json

# Team ID (optional, usually auto-detected)
# COREBLOW_TEAM_ID=XXXXXXXXXX
