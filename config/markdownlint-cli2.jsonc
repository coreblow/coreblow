{
  "globs": ["docs/**/*.md", "docs/**/*.mdx", "README.md"],
  "ignores": ["**/.local/**", "node_modules/**"],
  "config": {
    "default": true,
    "MD013": false,
    "MD025": false,
    "MD029": false,
    "MD033": {
      "allowed_elements": [
        "img",
        "a",
        "br",
        "details",
        "summary",
        "p",
        "strong"
      ]
    },
    "MD036": false,
    "MD040": false,
    "MD041": false,
    "MD046": false
  }
}
